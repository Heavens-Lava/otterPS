state count is 0
state menuOpen is false

derive doubled is count * 2

to counterCard
    card
        layout column
        align center
        gap 12
        round 12

        enter
            fade in
            move up 20
            animate 300ms ease-out
        .

        heading "Counter"

        text "Count: " + count
        text "Double: " + doubled

        primary button "Increase"
            hover
                grow 1.05
                animate 150ms
            .

            click
                count is count + 1
            .
        .

        secondary button "Menu"
            click
                menuOpen is not menuOpen
            .
        .

        if menuOpen
            panel
                layout stack
                gap 8

                text "Settings"
                text "Account"

                enter
                    fade in
                    slide in from left
                    animate 250ms
                .

                leave
                    fade out
                    animate 150ms
                .
            .
        .
    .
.

counterCard

when count changes
    say "Count changed to " + count
.

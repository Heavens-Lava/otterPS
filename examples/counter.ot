# Experimental Otter syntax.
# This example demonstrates planned post-v1 declarative UI/event/animation
# features (card, layout, enter/leave, hover/click blocks). It is not
# supported by Otter 1.0 - see D56 in SPEC-DECISIONS.md.
#
# The `state`/`derive`/`when count changes` lines below ARE frozen v1
# syntax and work correctly on their own; the `card`/`layout`/`click`
# declarative UI blocks further down are not, and its click handlers do
# not currently do anything (UiEvent is an explicit v1 error as of D56).

state count is 0
state menuOpen is false

derive doubled is count * 2

to counterCard
    card
        layout column
        align center
        gap 12
        round 12

        enter
            fade in
            move up 20
            animate 300ms ease-out
        .

        heading "Counter"

        text "Count: " + count
        text "Double: " + doubled

        primary button "Increase"
            hover
                grow 1.05
                animate 150ms
            .

            click
                count is count + 1
            .
        .

        secondary button "Menu"
            click
                menuOpen is not menuOpen
            .
        .

        if menuOpen
            panel
                layout stack
                gap 8

                text "Settings"
                text "Account"

                enter
                    fade in
                    slide in from left
                    animate 250ms
                .

                leave
                    fade out
                    animate 150ms
                .
            .
        .
    .
.

counterCard

when count changes
    say "Count changed to" count
.

# terminal.ot - Reusable Interactive Otter Terminal Component & Library
# Can be run standalone or imported into other Otter applications via `use "terminal.ot"`
#
# NOTE ON ARCHITECTURE (D60):
# This file defines the pure Otter UI Component (presentation, prompt, input, history, profiles).
# Real OS subprocess execution (git, dir, dotnet, bash) is backed by the Otter Desktop host
# (ConPTY on Windows, PTY on macOS/Linux) via Otter.Desktop.psm1 rather than unprivileged web sandboxes.

terminalPanel is a column with width full, height full, spacing 0, background "#ffffff", radius 8, border "1px solid #e2e8f0"

# --- Terminal Header Bar (Tabs & Profile Selector) ---
# ┌─ + ────────────────────── PowerShell ▾ ┐
termHeader is a row with spread, align middle, padding "4px 10px", background "#f8fafc", width full, customstyle "border-bottom: 1px solid #e2e8f0; border-radius: 8px 8px 0 0;"

termLeftNav is a row with spacing 8, align middle
termNewTabBtn is a button with text "+", background "#ffffff", foreground "#64748b", border "1px solid #cbd5e1", radius 4, weight 700, size 11, padding "2px 6px"
termTabTitle is a text with value "Terminal 1", weight 700, size 11, foreground "#0f172a"
termBadge is a badge with text "PowerShell", background "#eff6ff", foreground "#1d4ed8", size 10, padding "2px 6px", radius 4
put termNewTabBtn, termTabTitle, termBadge in termLeftNav

termRightActions is a row with spacing 4, align middle
profPowerShell is a button with text "PS", background "#eff6ff", foreground "#1d4ed8", radius 4, weight 700, size 10, padding "2px 5px"
profCmd is a button with text "CMD", background "#f1f5f9", foreground "#475569", radius 4, weight 700, size 10, padding "2px 5px"
profGitBash is a button with text "Bash", background "#f1f5f9", foreground "#475569", radius 4, weight 700, size 10, padding "2px 5px"
profWsl is a button with text "WSL", background "#f1f5f9", foreground "#475569", radius 4, weight 700, size 10, padding "2px 5px"
profRepl is a button with text "REPL", background "#fef3c7", foreground "#92400e", radius 4, weight 700, size 10, padding "2px 5px"
termClearBtn is a button with text "Clear", background "#ffffff", foreground "#64748b", border "1px solid #cbd5e1", radius 4, weight 600, size 10, padding "2px 6px"

put profPowerShell, profCmd, profGitBash, profWsl, profRepl, termClearBtn in termRightActions
put termLeftNav, termRightActions in termHeader

# --- Scrollable Terminal History Log ---
termScroll is a scroll with height 100, width full, background "#0f172a", foreground "#f8fafc"
termHistoryCol is a column with spacing 4, width full, padding 8, whitespace "pre", customstyle "font-family: 'Cascadia Code', Consolas, 'Courier New', monospace; font-size: 11px; line-height: 1.4; color: #f8fafc;"

termWelcome is a text with value "Windows PowerShell / PowerShell 7 [System Shell]\nType system shell commands (git, dotnet, dir) or 'otter run <file.ot>'.\n", foreground "#38bdf8", family "'Cascadia Code', Consolas, monospace", size 11, whitespace "pre"
termLog1 is a text with value "PS C:\projects\otterPS> git status\nOn branch main\nYour branch is up to date with 'origin/main'.\n", foreground "#94a3b8", family "'Cascadia Code', Consolas, monospace", size 11, whitespace "pre"
termLog2 is a text with value "PS C:\projects\otterPS> otter run examples/file-organizer/main.ot\nCopied beach.jpg\nCopied forest.jpg\nCopied mountain.png\nCopied photo.jpg\nCopied sunset.png\nAll done!\n", foreground "#a7f3d0", family "'Cascadia Code', Consolas, monospace", size 11, whitespace "pre"
termLog3 is a text with value "", foreground "#e2e8f0", family "'Cascadia Code', Consolas, monospace", size 11, whitespace "pre"

put termWelcome, termLog1, termLog2, termLog3 in termHistoryCol
put termHistoryCol in termScroll

# --- Terminal Command Input Row ---
termInputRow is a row with spacing 6, align middle, padding "4px 8px", background "#1e293b", width full, customstyle "border-top: 1px solid #334155; border-radius: 0 0 8px 8px;"
termPrompt is a text with value "PS C:\projects\otterPS> ", foreground "#22c55e", weight 700, family "'Cascadia Code', Consolas, monospace", size 11
termBox is a text box with placeholder "otter run main.ot", flex 1, background "#0f172a", foreground "#f8fafc", border "1px solid #334155", radius 4, family "'Cascadia Code', Consolas, monospace", size 11
termRunBtn is a button with text "↵ Run", background "#22c55e", foreground "#ffffff", radius 4, weight 700, size 11, padding "4px 10px"
put termPrompt, termBox, termRunBtn in termInputRow

put termHeader, termScroll, termInputRow in terminalPanel

# --- Terminal Event Handlers ---
when termRunBtn is clicked
    cmd is text of termBox
    if cmd is not ""
        run command cmd into cmdOutput
        text of termLog3 is text of termPrompt and cmd and "\n" and cmdOutput and "\n"
        text of termBox is ""
    .
.

when termClearBtn is clicked
    text of termLog1 is ""
    text of termLog2 is ""
    text of termLog3 is ""
.

# --- Profile Switcher Handlers ---
when profPowerShell is clicked
    text of termBadge is "PowerShell"
    text of termPrompt is "PS C:\projects\otterPS> "
    text of termWelcome is "PowerShell Profile Active [Default System Shell]\nDefault host: Windows PowerShell / PowerShell 7\n"
.

when profCmd is clicked
    text of termBadge is "Command Prompt"
    text of termPrompt is "C:\projects\otterPS> "
    text of termWelcome is "Microsoft Windows [Version 10.0] - Command Prompt\n(c) Microsoft Corporation. All rights reserved.\n"
.

when profGitBash is clicked
    text of termBadge is "Git Bash"
    text of termPrompt is "user@otter:~/projects/otterPS$ "
    text of termWelcome is "Git Bash (MINGW64) Profile Active\n"
.

when profWsl is clicked
    text of termBadge is "WSL (Linux)"
    text of termPrompt is "otter@linux:~/projects/otterPS$ "
    text of termWelcome is "WSL2 Ubuntu Linux Subsystem Active\n"
.

when profRepl is clicked
    text of termBadge is "Otter REPL"
    text of termPrompt is "otter> "
    text of termWelcome is "Otter Interactive REPL 0.2.0\nType Otter language expressions (e.g. name is \"Jeff\", say name).\n"
.

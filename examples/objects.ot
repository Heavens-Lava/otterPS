# objects.ot - things and their properties
#
# Properties are read with "of", never with a period.

person has
    name is "Jeff"
    age is 29
.

say name of person
say name of person "is" age of person "years old."

age of person is 30

say "Now" age of person

# Nesting reads right to left:
# the city of the address of the user.

address has
    city is "Tucson"
.

user has
    address is address
.

say city of address of user
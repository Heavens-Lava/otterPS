# jeffreymacy.ot - Faithful recreation of www.jeffreymacy.com
# Built with pure Otter code using our modern Web Application Compiler (D50)

app is a page
    title is "Small Business Websites & Custom Web Apps | Jeffrey Macy"
    hideheader is true
    width is "100%"
    maxwidth is 1280
    background is "radial-gradient(circle at 82% 18%, rgba(214, 239, 224, 0.55) 0%, rgba(251, 251, 249, 0.95) 60%), #fbfbf9"
    foreground is "#111827"
    spacing is 24
    padding is 28
.

# ==========================================
# 1. TOP NAVIGATION BAR
# ==========================================

navbar is a row
    justify is "space-between"
    alignitems is "center"
    spacing is 16
    padding is 6
.

brandGroup is a row
    spacing is 12
    alignitems is "center"
.

avatarBadge is a badge
    text is "JM"
    background is "#16382c"
    foreground is "#e8d2b5"
    radius is 9999
    weight is 700
    size is 15
    padding is 10
.

brandInfoCol is a column
    spacing is 2
.

brandName is a text
    value is "Jeffrey Macy"
    weight is 700
    size is 17
    foreground is "#111827"
.

brandTagline is a text
    value is "Technology partner for growing businesses"
    size is 12
    foreground is "#6b7280"
.

put brandName, brandTagline in brandInfoCol
put avatarBadge, brandInfoCol in brandGroup

navLinksRow is a row
    spacing is 22
    alignitems is "center"
.

navHome is a link
    text is "Home"
    url is "#"
    foreground is "#111827"
    weight is 600
    size is 14
.

navResources is a link
    text is "Resources"
    url is "#"
    foreground is "#4b5563"
    size is 14
.

navServices is a link
    text is "Services"
    url is "#"
    foreground is "#4b5563"
    size is 14
.

navProjects is a link
    text is "Projects"
    url is "#"
    foreground is "#4b5563"
    size is 14
.

navAbout is a link
    text is "About"
    url is "#"
    foreground is "#4b5563"
    size is 14
.

themePill is a badge
    text is "☀️ ↻"
    background is "#f3f4f6"
    foreground is "#4b5563"
    radius is 9999
    border is "1px solid #e5e7eb"
    padding is 6
    size is 12
.

navPlanBtn is a button
    text is "Plan My Website →"
    background is "#184537"
    foreground is "white"
    radius is 9999
    weight is 600
    padding is 10
    size is 14
.

navLogin is a link
    text is "Log in"
    url is "#"
    foreground is "#4b5563"
    weight is 500
    size is 14
.

put navHome, navResources, navServices, navProjects, navAbout, themePill, navPlanBtn, navLogin in navLinksRow
put brandGroup, navLinksRow in navbar

# ==========================================
# 2. HERO SECTION
# ==========================================

heroRow is a row
    justify is "space-between"
    alignitems is "flex-start"
    spacing is 48
    margin is 16
.

# --- Left Column: Hero Content & Pricing ---
leftCol is a column
    flex is 1.15
    spacing is 20
.

eyebrowRow is a row
    spacing is 8
    alignitems is "center"
.

eyebrowDash is a text
    value is "―"
    foreground is "#ea580c"
    weight is 800
    size is 16
.

eyebrowText is a text
    value is "WEBSITES FOR PEOPLE WHO CARE ABOUT THEIR CUSTOMERS"
    size is 11
    weight is 700
    letterspacing is "0.08em"
    foreground is "#1e4d3e"
.

put eyebrowDash, eyebrowText in eyebrowRow

headlineCol is a column
    spacing is 2
.

headLine1 is a text
    value is "You take care of your customers."
    size is 44
    weight is 800
    foreground is "#0f172a"
    letterspacing is "-0.025em"
    lineheight is "1.15"
.

headLine2 is a text
    value is "I'll take care of your website."
    size is 48
    weight is 600
    fontstyle is "italic"
    family is "'Newsreader', 'Playfair Display', Georgia, serif"
    foreground is "#184537"
    lineheight is "1.15"
.

put headLine1, headLine2 in headlineCol

subHead is a text
    value is "More than a website—build a digital home for your business."
    size is 18
    weight is 700
    foreground is "#1f2937"
.

subDesc is a text
    value is "Help customers find you, understand your services, see your pricing, book appointments, make payments, access files and videos, and stay connected with your business."
    size is 15
    foreground is "#4b5563"
    lineheight is "1.65"
.

ctaRow is a row
    spacing is 16
    alignitems is "center"
.

heroCtaBtn is a button
    text is "Plan My Website →"
    background is "#184537"
    foreground is "white"
    radius is 9999
    weight is 600
    padding is 14
    size is 15
.

heroEstimateBtn is a button
    text is "Get a Free Cost Estimate ⚡"
    background is "#ffffff"
    foreground is "#111827"
    radius is 9999
    border is "1px solid #d1d5db"
    weight is 600
    padding is 14
    size is 15
.

put heroCtaBtn, heroEstimateBtn in ctaRow

# Pricing Comparison Card
pricingCard is a card
    background is "#ffffff"
    radius is 16
    border is "1px solid #e5e7eb"
    shadow is "0 4px 20px rgba(0,0,0,0.03)"
    padding is 20
    spacing is 16
.

pricingHeaderRow is a row
    justify is "space-between"
    alignitems is "center"
.

pricingCardTitle is a text
    value is "Simple, upfront starting prices"
    size is 14
    weight is 700
    foreground is "#111827"
.

compareLink is a link
    text is "Compare packages"
    url is "#"
    size is 13
    foreground is "#184537"
    weight is 600
.

put pricingCardTitle, compareLink in pricingHeaderRow

pricingTiersRow is a row
    justify is "space-between"
    alignitems is "center"
    spacing is 16
.

tier1Col is a column
    spacing is 4
    flex is 1
.

t1Name is a text
    value is "Starter"
    size is 12
    foreground is "#6b7280"
.

t1Price is a text
    value is "$750"
    size is 22
    weight is 800
    foreground is "#111827"
.

put t1Name, t1Price in tier1Col

tier2Col is a column
    spacing is 4
    flex is 1
    border is "1px solid #f1f5f9"
    padding is 8
    radius is 8
.

t2Name is a text
    value is "Business"
    size is 12
    foreground is "#6b7280"
.

t2Price is a text
    value is "From $1,500"
    size is 22
    weight is 800
    foreground is "#111827"
.

put t2Name, t2Price in tier2Col

tier3Col is a column
    spacing is 4
    flex is 1
    border is "1px solid #f1f5f9"
    padding is 8
    radius is 8
.

t3Name is a text
    value is "Business Platform"
    size is 12
    foreground is "#6b7280"
.

t3Price is a text
    value is "From $2,500+"
    size is 22
    weight is 800
    foreground is "#111827"
.

put t3Name, t3Price in tier3Col

put tier1Col, tier2Col, tier3Col in pricingTiersRow
put pricingHeaderRow, pricingTiersRow in pricingCard

subLinksRow is a row
    spacing is 14
    alignitems is "center"
.

subLearnLink is a link
    text is "I Just Want to Learn More →"
    url is "#"
    size is 13
    foreground is "#184537"
    weight is 600
.

bulletPoint is a text
    value is "•"
    foreground is "#d1d5db"
.

subDemosLink is a link
    text is "Explore Demos & Work →"
    url is "#"
    size is 13
    foreground is "#184537"
    weight is 600
.

put subLearnLink, bulletPoint, subDemosLink in subLinksRow

guaranteeNote is a text
    value is "✓ Transparent pricing, zero sales pressure. Calculate your scope in 60 seconds."
    size is 12
    foreground is "#6b7280"
.

put eyebrowRow, headlineCol, subHead, subDesc, ctaRow, pricingCard, subLinksRow, guaranteeNote in leftCol

# --- Right Column: Interactive Scope Estimator Mockup ---
rightCol is a column
    flex is 0.95
    spacing is 16
.

mockupCard is a card
    background is "#ffffff"
    radius is 20
    border is "1px solid #e6ebe4"
    shadow is "0 25px 50px -12px rgba(24,69,55,0.12), 0 8px 24px rgba(0,0,0,0.04)"
    padding is 24
    spacing is 14
    width is "100%"
.

mockupTopRow is a row
    spacing is 8
    alignitems is "center"
.

dot1 is a badge
    text is " "
    background is "#ef4444"
    radius is 9999
    padding is 4
    size is 8
.

dot2 is a badge
    text is " "
    background is "#f59e0b"
    radius is 9999
    padding is 4
    size is 8
.

dot3 is a badge
    text is " "
    background is "#10b981"
    radius is 9999
    padding is 4
    size is 8
.

mockUrl is a text
    value is "estimator.jeffreymacy.com"
    size is 11
    foreground is "#9ca3af"
.

put dot1, dot2, dot3, mockUrl in mockupTopRow

stepIndicator is a text
    value is "1. YOUR CURRENT STEP  |  STEP 1 OF 3"
    size is 11
    weight is 700
    foreground is "#ea580c"
    letterspacing is "0.05em"
.

stepProgressRow is a row
    spacing is 0
    alignitems is "center"
    width is "100%"
.

progressBarActive is a badge
    text is " "
    background is "#ea580c"
    height is 4
    width is 100
    radius is 2
    padding is 0
.

progressBarRemaining is a badge
    text is " "
    background is "#e5e7eb"
    height is 4
    flex is 1
    radius is 2
    padding is 0
.

put progressBarActive, progressBarRemaining in stepProgressRow

stepTitle is a text
    value is "Where are you today?"
    size is 22
    weight is 800
    foreground is "#111827"
.

# Quick selectable option cards
opt1Btn is a button
    text is "I don't have a website yet (Starter)"
    background is "#f8fafc"
    border is "1px solid #cbd5e1"
    foreground is "#1e293b"
    radius is 8
    padding is 10
    size is 13
    weight is 600
.

opt2Btn is a button
    text is "I want to rebuild my existing site (Business)"
    background is "#f8fafc"
    border is "1px solid #cbd5e1"
    foreground is "#1e293b"
    radius is 8
    padding is 10
    size is 13
    weight is 600
.

opt3Btn is a button
    text is "I need custom software or client portal (Platform)"
    background is "#f8fafc"
    border is "1px solid #cbd5e1"
    foreground is "#1e293b"
    radius is 8
    padding is 10
    size is 13
    weight is 600
.

timelinePrompt is a text
    value is "Target delivery timeline (weeks):"
    size is 13
    foreground is "#4b5563"
    weight is 600
.

timelineSlider is a slider
    min is 2
    max is 12
    value is 4
    width is "100%"
.

scopeNotes is a text area
    placeholder is "What are the most important goals or features for your website?"
    rows is 2
.

calculateScopeBtn is a button
    text is "Calculate Scope & Price"
    background is "#184537"
    foreground is "white"
    radius is 10
    weight is 600
    padding is 12
    size is 14
.

estimateResult is a text
    value is "Estimated Scope: Starter Site ($750) • Turnaround: ~3-4 weeks"
    background is "#f0fdf4"
    border is "1px solid #bbf7d0"
    foreground is "#166534"
    padding is 12
    radius is 8
    weight is 600
    size is 13
.

put mockupTopRow, stepIndicator, stepProgressRow, stepTitle, opt1Btn, opt2Btn, opt3Btn, timelinePrompt, timelineSlider, scopeNotes, calculateScopeBtn, estimateResult in mockupCard
put mockupCard in rightCol

put leftCol, rightCol in heroRow

# ==========================================
# 3. FLOATING WIDGETS
# ==========================================

floatingDock is a row
    position is "fixed"
    bottom is 24
    right is 28
    zindex is 999
    spacing is 12
    alignitems is "center"
.

chatWidgetBtn is a button
    text is "💬 Ask how Jeffrey can help"
    background is "#163b2c"
    foreground is "white"
    radius is 9999
    weight is 600
    padding is 12
    size is 14
    shadow is "0 10px 25px rgba(22,59,44,0.3)"
.

accessibilityBtn is a button
    text is "🌐"
    background is "#163b2c"
    foreground is "white"
    radius is 9999
    padding is 12
    size is 14
    shadow is "0 10px 25px rgba(22,59,44,0.3)"
.

put chatWidgetBtn, accessibilityBtn in floatingDock

# ==========================================
# 4. INTERACTIVE REACTIVITY & EVENT HANDLERS
# ==========================================

when opt1Btn is clicked
    text of estimateResult is "Selected: Starter Site ($750) • Upfront fixed pricing • Turnaround: ~2-3 weeks"
.

when opt2Btn is clicked
    text of estimateResult is "Selected: Business Modernization (From $1,500) • Fast React design & SEO • 3-4 weeks"
.

when opt3Btn is clicked
    text of estimateResult is "Selected: Custom Platform (From $2,500+) • Client portals, payments & automation • 6-8 weeks"
.

when calculateScopeBtn is clicked
    notes is text of scopeNotes
    if notes is empty
        text of estimateResult is "Scope Calculated: Recommended Business Package ($1,500) with full setup & launch support."
    otherwise
        text of estimateResult is notes
    .
.

when timelineSlider is changed
    text of estimateResult is "Timeline updated. Project scheduling & delivery window optimized!"
.

when heroCtaBtn is clicked
    text of estimateResult is "Step 1 of 3: Select your starting point above to calculate your exact project scope!"
.

when heroEstimateBtn is clicked
    text of estimateResult is "Free Cost Estimate: Starter ($750) | Business ($1,500) | Platform ($2,500+)"
.

when chatWidgetBtn is clicked
    text of estimateResult is "Jeffrey Macy: 'Hi! Let me know what you need and I will personally help you plan your website.'"
.

when accessibilityBtn is clicked
    text of estimateResult is "Display mode adjusted for optimal contrast and readability."
.

# Assemble and render page
put navbar, heroRow, floatingDock in app
show app

create window into app
app has title is "Otter File Utility", width is 700, height is 500, background is "#111827", spacing is 12

create text into heading
heading has text is "Folder Browser", foreground is "white"

create text box into folderBox
folderBox has width is 500

create button into loadButton
loadButton has text is "Load Files", width is 120, background is "#2563EB", foreground is "white"

create text into resultText
resultText has text is "Enter a folder path.", foreground is "white"

put heading, folderBox, loadButton, resultText in app

when loadButton is clicked
    try
        folder is text of folderBox
        get files in folder into files
        total is length of files
        text of resultText is total
    otherwise
        text of resultText is "Could not load that folder."
.

show app

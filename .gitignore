# Release packaging output (tools/Build-OtterRelease.ps1) - rebuildable from
# a clean checkout, never committed.
dist/
scratch/
.playwright-mcp/
backup/
debug.log
otter-site-publish/
examples/file-organizer/output/

# OtterWorkspace release output and temporary project-manifest fixtures.
OtterWorkspace/publish/
OtterWorkspace/test_manifest_project/
test_manifest_project/

# Release-certification run records (tools/Invoke-OtterReleaseCertification.ps1).
# A record that certifies a candidate is copied into docs/ deliberately.
release/certification/

# Temporary projects created by otter-studio tests (otter-studio/scripts/test-scratch.mjs).
projects/.studio-test-tmp/

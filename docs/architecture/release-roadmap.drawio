<mxfile host="Electron" agent="Otter architecture builder" version="31.4.5">
  <diagram id="release-roadmap-and-certification-map" name="Release Roadmap and Certification Map">
    <mxGraphModel dx="1800" dy="1120" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1050" background="#f8fafc" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:28px&quot;&gt;RELEASE ROADMAP &amp; CERTIFICATION MAP&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:16px;color:#cbd5e1&quot;&gt;P0 → P7, driven by both permanent master checklists&lt;/span&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#0f172a;strokeColor=#0f172a;fontColor=#ffffff;shadow=1;align=left;spacingLeft=28;;" vertex="1" parent="1"><mxGeometry x="25" y="20" width="1750" height="105" as="geometry"/></mxCell>
        <mxCell id="3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P0&lt;/b&gt;&lt;br&gt;&lt;b&gt;Protect &amp; freeze foundations&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Preserve current work · reconcile architecture&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;6/10&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;shadow=1;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="70" y="235" width="365" height="190" as="geometry"/></mxCell>
        <mxCell id="4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P1&lt;/b&gt;&lt;br&gt;&lt;b&gt;Language / runtime parity&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Core semantics · providers · conformance&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;11/20&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;shadow=1;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="495" y="235" width="365" height="190" as="geometry"/></mxCell>
        <mxCell id="5" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P2&lt;/b&gt;&lt;br&gt;&lt;b&gt;Studio journey + Console/System&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Open/edit/save/run · administration capabilities&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;21/25&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;shadow=1;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="920" y="235" width="365" height="190" as="geometry"/></mxCell>
        <mxCell id="6" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P3&lt;/b&gt;&lt;br&gt;&lt;b&gt;Designer + Desktop/Web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Round trip · UI runtime · web/backend completion&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;18/21&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="1345" y="235" width="365" height="190" as="geometry"/></mxCell>
        <mxCell id="7" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P4&lt;/b&gt;&lt;br&gt;&lt;b&gt;Professional language ecosystem&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Language service · packages · build system&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;8/13&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#fffbeb;strokeColor=#d97706;fontColor=#0f172a;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="1345" y="590" width="365" height="190" as="geometry"/></mxCell>
        <mxCell id="8" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P5&lt;/b&gt;&lt;br&gt;&lt;b&gt;Build/Debug + Games&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Run/debug lifecycle · game foundations&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2/11&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="920" y="590" width="365" height="190" as="geometry"/></mxCell>
        <mxCell id="9" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:20px&quot;&gt;P6&lt;/b&gt;&lt;br&gt;&lt;b&gt;Tests/Packages/Git + 3D&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#475569&quot;&gt;Testing · source control · extensions · 3D&lt;/span&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;2/15&lt;/b&gt; checklist gates complete&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f8fafc;strokeColor=#64748b;fontColor=#0f172a;align=left;spacingLeft=18;;" vertex="1" parent="1"><mxGeometry x="495" y="590" width="365" height="190" as="geometry"/></mxCell>

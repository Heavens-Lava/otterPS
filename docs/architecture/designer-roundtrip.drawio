        <mxCell id="26" value="&lt;b&gt;ROUND-TRIP CERTIFICATION GATE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:14px&quot;&gt;parse → model → generate → parse again → equivalent AST → equivalent rendered UI&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Segoe UI;fontSize=15;align=center;verticalAlign=middle;strokeWidth=2;fillColor=#f0fdf4;strokeColor=#16a34a;fontColor=#0f172a;shadow=1;" vertex="1" parent="1"><mxGeometry x="250" y="730" width="1300" height="105" as="geometry"/></mxCell>

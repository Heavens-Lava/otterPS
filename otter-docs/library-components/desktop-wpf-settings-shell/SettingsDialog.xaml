<Window x:Class="OtterLibrary.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Application Settings"
        Width="680"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F4F7FB">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,1,0,0" Padding="16,12">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" Width="92" Height="32" Margin="0,0,8,0" IsCancel="True" />
        <Button Content="Save Changes" Width="116" Height="32" IsDefault="True" Click="OnSaveClick" />
      </StackPanel>
    </Border>

    <TabControl TabStripPlacement="Left" BorderThickness="0" Background="Transparent">
      <TabItem Header="General" Padding="14,10">
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="General Preferences" FontSize="18" FontWeight="SemiBold" Foreground="#0B1D36" />
          <CheckBox Content="Check for offline pack updates on startup" IsChecked="{Binding CheckUpdatesOnStart}" />
          <CheckBox Content="Confirm before overwriting modified files" IsChecked="{Binding ConfirmOverwrites}" />
        </StackPanel>
      </TabItem>
      <TabItem Header="Storage" Padding="14,10">
        <StackPanel Margin="20" Spacing="12">
          <TextBlock Text="Local Library Cache" FontSize="18" FontWeight="SemiBold" Foreground="#0B1D36" />
          <TextBlock Text="Default Library Folder" Foreground="#475569" />
          <TextBox Height="32" VerticalContentAlignment="Center" Padding="8,0" Text="{Binding LibraryPath}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>

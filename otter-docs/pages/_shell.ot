# _shell.ot - the shared page chrome for the Otter website: top navigation and footer.
# Every page pulls this in with `use "_shell.ot"`, puts `topBar` first and
# `siteFooter` last, and marks its own link as current by assigning
# `customstyle of nav<Page> is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"`.

brandMark is a image with source "/static/images/otter-explorer-icon.png", alt "Otter", width 34, height 34, radius 17
brandName is a link with text "Otter", url "/", foreground "#ffffff", size 22, weight 700, letterspacing "-0.01em"
brandGroup is a row with spacing 10, align middle
put brandMark, brandName in brandGroup

navDocs is a link with text "Documentation", url "/docs/", foreground "#d7e3f4", size 14, weight 500, customstyle "padding: 22px 0; border-bottom: 2px solid transparent;"
navDownload is a link with text "Download", url "/download/", foreground "#d7e3f4", size 14, weight 500, customstyle "padding: 22px 0; border-bottom: 2px solid transparent;"
navCommunity is a link with text "Community", url "/support/", foreground "#d7e3f4", size 14, weight 500, customstyle "padding: 22px 0; border-bottom: 2px solid transparent;"
navBlog is a link with text "Blog", url "https://github.com/Heavens-Lava/otterPS", foreground "#d7e3f4", size 14, weight 500, customstyle "padding: 22px 0; border-bottom: 2px solid transparent;"
# Kept as resources because existing pages mark them active. The reference-style
# header deliberately keeps the visible navigation to four primary choices.
navReference is a link with text "Reference", url "/reference/", foreground "#d7e3f4", size 14, weight 500
navExamples is a link with text "Examples", url "/examples/", foreground "#d7e3f4", size 14, weight 500
navRelease is a link with text "Release", url "/release/", foreground "#d7e3f4", size 14, weight 500
docsSearchButton is a button with text "Search documentation...   Ctrl K", size 12, weight 500, background "#173252", foreground "#dbeafe", radius 8, padding "8px 14px", customstyle "border: 1px solid #315377; min-width: 206px; text-align: left;"
navGitHub is a link with text "GitHub", url "https://github.com/Heavens-Lava/otterPS", foreground "#ffffff", size 13, weight 700, customstyle "padding: 8px 0;"
navLinks is a row with spacing 25, align middle
put navDocs, navDownload, navCommunity, navBlog, docsSearchButton, navGitHub in navLinks

topBar is a row with spread, align middle, spacing 36, width full, background "#0b1d36", padding "0 40px", height 64, customstyle "box-sizing: border-box; position: sticky; top: 0; z-index: 50;"
put brandGroup, navLinks in topBar


footerNote is a text with value "Otter is free to use, including for commercial software. Created by Jeffrey Macy.", size 13, foreground "#8fa3c2"
footerDocsLink is a link with text "Docs", url "/docs/", foreground "#b7c4d8", size 13
footerDownloadLink is a link with text "Download", url "/download/", foreground "#b7c4d8", size 13
footerLicense is a link with text "License", url "/license/", foreground "#b7c4d8", size 13
footerAbout is a link with text "About", url "/about/", foreground "#b7c4d8", size 13
footerContact is a link with text "Contact", url "/support/", foreground "#b7c4d8", size 13
footerSource is a link with text "GitHub", url "https://github.com/Heavens-Lava/otterPS", foreground "#b7c4d8", size 13
footerLinks is a row with spacing 20, align middle
put footerDocsLink, footerDownloadLink, footerLicense, footerAbout, footerContact, footerSource in footerLinks
siteFooter is a row with spread, align middle, spacing 24, width full, background "#0b1d36", padding "26px 40px", customstyle "box-sizing: border-box; margin-top: 40px;"
put footerNote, footerLinks in siteFooter

b1 is a text with value "Cryptography and secrets", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Safe algorithms and parameters are the runtime's job. You say what you want - encrypt, hash a password, generate random bytes - not which cipher to use.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Availability: this feature is in the current source tree and is not part of a published release yet.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b4 is a text with value "Bytes", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b5 is a text with value "Everything here works on bytes, Otter's binary type. Text and bytes are never converted silently; ask for the conversion you mean:", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "data is bytes from text \"Hello\"\nsay hex from bytes data\nsay base64 from bytes data\nsay text from bytes data\nsay length of data", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b6label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b6copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b6head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b6label, b6copy in b6head
b6block is a column with spacing 0, width full
put b6head, b6 in b6block
when b6copy is clicked
    copy text of b6 to clipboard
    text of b6copy is "Copied"
.
b7 is a text with value "Hashing and signing", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "data is bytes from text \"abc\"\n\ndigest is sha256 of data\nsay hex from bytes digest\n\nkey is bytes from text \"shared secret\"\nsignature is hmac sha256 of data using key\nsay hex from bytes signature", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b8label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b8copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b8head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b8label, b8copy in b8head
b8block is a column with spacing 0, width full
put b8head, b8 in b8block
when b8copy is clicked
    copy text of b8 to clipboard
    text of b8copy is "Copied"
.
b9 is a text with value "sha256, sha384 and sha512 are available, and the same three for hmac. Obsolete hashes such as MD5 and SHA-1 are deliberately left out.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "Secure random bytes", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "token is secure random bytes 32\nsay hex from bytes token", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b11label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b11copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b11head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11label, b11copy in b11head
b11block is a column with spacing 0, width full
put b11head, b11 in b11block
when b11copy is clicked
    copy text of b11 to clipboard
    text of b11copy is "Copied"
.
b12 is a text with value "This uses the operating system's cryptographically secure source, unlike Otter's general random numbers.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "Encryption", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b14 is a text with value "Encryption is authenticated: tampered or wrongly-keyed data is refused, never returned as garbage. The nonce is handled for you and stored inside the result.", size 16, foreground "#3a4d6b", lineheight "1.6"
b15 is a text with value "generate encryption key and call it key\n\nmessage is bytes from text \"Attack at dawn\"\nencrypt message using key and call it encrypted\ndecrypt encrypted using key and call it original\n\nsay text from bytes original", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b15label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b15copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b15head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b15label, b15copy in b15head
b15block is a column with spacing 0, width full
put b15head, b15 in b15block
when b15copy is clicked
    copy text of b15 to clipboard
    text of b15copy is "Copied"
.
b16 is a text with value "Attack at dawn", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b16label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b16copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b16head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b16label, b16copy in b16head
b16block is a column with spacing 0, width full
put b16head, b16 in b16block
when b16copy is clicked
    copy text of b16 to clipboard
    text of b16copy is "Copied"
.
b17 is a text with value "Store or send the result with base64 from bytes encrypted, and restore it with bytes from base64 encoded.", size 16, foreground "#3a4d6b", lineheight "1.6"
b18 is a text with value "Passwords", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b19 is a text with value "Passwords are not hashed like other data. hash password uses a slow, salted algorithm chosen by the runtime and gives you text you can store safely:", size 16, foreground "#3a4d6b", lineheight "1.6"
b20 is a text with value "password is \"correct horse battery staple\"\nhash password password and call it storedHash\n\nif password password matches hash storedHash\n    say \"Correct\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b20label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b20copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b20head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b20label, b20copy in b20head
b20block is a column with spacing 0, width full
put b20head, b20 in b20block
when b20copy is clicked
    copy text of b20 to clipboard
    text of b20copy is "Copied"
.
b21 is a text with value "Comparing secrets", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b22 is a text with value "securely equals compares bytes in constant time, so timing does not leak how much of a secret matched:", size 16, foreground "#3a4d6b", lineheight "1.6"
b23 is a text with value "if expected securely equals actual\n    say \"Valid\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b23label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b23copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b23head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b23label, b23copy in b23head
b23block is a column with spacing 0, width full
put b23head, b23 in b23block
when b23copy is clicked
    copy text of b23 to clipboard
    text of b23copy is "Copied"
.
b24 is a text with value "The credential vault", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b25 is a text with value "Store secrets such as API tokens in the operating system's credential store instead of a file. Secrets are scoped to your program: two different Otter programs storing \"api-token\" never see each other's value.", size 16, foreground "#3a4d6b", lineheight "1.6"
b26 is a text with value "if secret \"api-token\" exists\n    token is secret \"api-token\"\notherwise\n    ask secretly \"API token:\" and call it token\n    store secret \"api-token\" with value token\n.\n\ndelete secret \"api-token\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b26label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b26copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b26head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b26label, b26copy in b26head
b26block is a column with spacing 0, width full
put b26head, b26 in b26block
when b26copy is clicked
    copy text of b26 to clipboard
    text of b26copy is "Copied"
.
b27 is a text with value "A secret holds text or bytes and comes back as the same kind. Reading a secret that does not exist is an error, never an empty string. On Windows the vault is the Windows Credential Manager.", size 16, foreground "#3a4d6b", lineheight "1.6"
b28 is a text with value "Cryptography and the vault are console features. The web target reports them as unsupported - browser storage is not a secure credential store.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b29 is a link with text "Back to the reference", url "/reference/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6block, b7, b8block, b9, b10, b11block, b12, b13, b14, b15block, b16block, b17, b18, b19, b20block, b21, b22, b23block, b24, b25, b26block, b27, b28, b29 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

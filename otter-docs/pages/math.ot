b1 is a text with value "Math", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Arithmetic in everyday words: and, minus, times, divided by, and make.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Addition:", size 16, foreground "#3a4d6b", lineheight "1.6"
b4 is a text with value "number1 is 5\nnumber2 is 5\n\nnumber1 and number2 make total\n\nsay total", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b4label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b4copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.

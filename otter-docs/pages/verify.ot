# Otter website - Verify your installation
# Authored in Otter. Scaffolded by scripts/new-docs-page.ps1, now edited here directly.

use "_shell.ot"
use "_docs.ot"

app is a page with title "Verify your installation - Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navDocs is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"
customstyle of sideVerify is "padding: 8px 12px; border-left: 3px solid #2563eb; border-radius: 4px; display: block; background: #e6efff; color: #1d4ed8; font-weight: 600;"
# Sidebar: only the current group is expanded.
customstyle of sideCli is "display: none;"
customstyle of sideProjects is "display: none;"
customstyle of sideTroubleshooting is "display: none;"
customstyle of sideValues is "display: none;"
customstyle of sideInputOutput is "display: none;"
customstyle of sideConditions is "display: none;"
customstyle of sideLoops is "display: none;"
customstyle of sideLists is "display: none;"
customstyle of sideFunctions is "display: none;"
customstyle of sideObjects is "display: none;"
customstyle of sideFiles is "display: none;"
customstyle of sideData is "display: none;"
customstyle of sideErrorHandling is "display: none;"
customstyle of sideMath is "display: none;"
customstyle of sideNestedConditions is "display: none;"
customstyle of sideModules is "display: none;"
customstyle of sideRunningPrograms is "display: none;"
customstyle of sideLoggingDebugging is "display: none;"
customstyle of sideEnvironment is "display: none;"
customstyle of sideGone is "display: none;"
customstyle of sideOperators is "display: none;"
customstyle of sidePropertyAccess is "display: none;"
customstyle of sideStrings is "display: none;"
customstyle of sideCollections is "display: none;"
customstyle of sideDiscovery is "display: none;"
customstyle of sideFileObjects is "display: none;"
customstyle of sideFilesFolders is "display: none;"
customstyle of sideFolders is "display: none;"
customstyle of sideTry is "display: none;"
customstyle of sideJson is "display: none;"
customstyle of sideRandom is "display: none;"
customstyle of sideDates is "display: none;"
customstyle of sideScope is "display: none;"
customstyle of sideDiagnostics is "display: none;"
customstyle of sideReference is "display: none;"
customstyle of sideDatabases is "display: none;"
customstyle of sideQueries is "display: none;"
customstyle of sideHttp is "display: none;"
customstyle of sideWebServer is "display: none;"
customstyle of sideXml is "display: none;"
customstyle of sideWebApps is "display: none;"
customstyle of sideReactivity is "display: none;"
customstyle of sideWindowsApps is "display: none;"
customstyle of sideNetworking is "display: none;"
customstyle of sideSecurity is "display: none;"
customstyle of sideExamples is "display: none;"
customstyle of sideExampleHello is "display: none;"
customstyle of sideExampleInput is "display: none;"
customstyle of sideExampleConditions is "display: none;"
customstyle of sideExampleCounting is "display: none;"
customstyle of sideExampleLists is "display: none;"
customstyle of sideExampleDiscovery is "display: none;"
customstyle of sideExampleOrganizer is "display: none;"
customstyle of sideExampleFinding is "display: none;"
customstyle of sideExampleErrors is "display: none;"
customstyle of sideDesignReadable is "display: none;"
customstyle of sideStructuralWords is "display: none;"
customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"
customstyle of sideSupport is "display: none;"
customstyle of sideAbout is "display: none;"
customstyle of sideLicense is "display: none;"

b1 is a text with value "Verify your installation", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Three quick checks confirm that Otter is installed and working.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "1. Check the version", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "otter --version", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b4label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b4copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Otter {{RELEASE_VERSION}}", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b5label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b5copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b5head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b5label, b5copy in b5head
b5block is a column with spacing 0, width full
put b5head, b5 in b5block
when b5copy is clicked
    copy text of b5 to clipboard
    text of b5copy is "Copied"
.
b6 is a text with value "Running from the project folder without installing? Use .\\otter.cmd --version.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "2. Try the interactive session", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "Run otter with nothing after it to start the REPL, type a statement, and press Enter. Type exit to leave.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "otter", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b9label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b9copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b9head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b9label, b9copy in b9head
b9block is a column with spacing 0, width full
put b9head, b9 in b9block
when b9copy is clicked
    copy text of b9 to clipboard
    text of b9copy is "Copied"
.
b10 is a text with value "3. Run a program", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "Save one line as hello.ot and run it:", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "say \"Hello, world!\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b12label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b12copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b12head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b12label, b12copy in b12head
b12block is a column with spacing 0, width full
put b12head, b12 in b12block
when b12copy is clicked
    copy text of b12 to clipboard
    text of b12copy is "Copied"
.
b13 is a text with value "otter hello.ot", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b13label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b13copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b13head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b13label, b13copy in b13head
b13block is a column with spacing 0, width full
put b13head, b13 in b13block
when b13copy is clicked
    copy text of b13 to clipboard
    text of b13copy is "Copied"
.
b14 is a text with value "Hello, world!", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b14label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b14copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b14head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b14label, b14copy in b14head
b14block is a column with spacing 0, width full
put b14head, b14 in b14block
when b14copy is clicked
    copy text of b14 to clipboard
    text of b14copy is "Copied"
.
b15 is a text with value "If a command is not found, see Troubleshooting: it is almost always a terminal that was opened before the PATH changed.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b16 is a link with text "Troubleshooting", url "/troubleshooting/", foreground "#2563eb", weight 600, size 15
b17 is a link with text "Next: your first program", url "/first-program/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4block, b5block, b6, b7, b8, b9block, b10, b11, b12block, b13block, b14block, b15, b16, b17 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

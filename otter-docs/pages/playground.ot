# Otter website - Interactive Otter Playground (/playground/)
# Authored in Otter using the shared website shell (_shell.ot).
# Powered client-side by the real Otter 1.0.1 .NET WebAssembly interpreter inside a Web Worker.

use "_shell.ot"

app is a page with title "Otter Playground - Write and Run Otter in Your Browser", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navPlayground is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"

heroEyebrow is a text with value "REAL OTTER 1.0.1 · WEBASSEMBLY COMPILER & SANDBOX", size 12, weight 700, foreground "#7dd3fc", letterspacing "0.1em"
heroTitle is a text with value "Otter Playground", size 42, weight 800, foreground "#ffffff", letterspacing "-0.03em", lineheight "1.08"
heroSub is a text with value "Write, compile, and run real Otter 1.0.1 console programs and live River Slate Web UI apps right in your browser. Powered 100% client-side by the canonical C# compiler and runtime in WebAssembly — nothing is sent to a server.", size 17, foreground "#dbeafe", lineheight "1.55", customstyle "max-width: 860px;"
heroInner is a column with spacing 10, customstyle "max-width: 1280px; width: 100%; margin: 0 auto; padding: 36px 32px 40px; box-sizing: border-box;"
put heroEyebrow, heroTitle, heroSub in heroInner
pgHero is a column with spacing 0, width full, background "#0b1d36", customstyle "background: linear-gradient(135deg, #0b1d36 0%, #13315c 58%, #1d4ed8 100%);"
put heroInner in pgHero

playgroundMount is a column with spacing 0, width full, customstyle "max-width: 1280px; margin: 0 auto; padding: 24px 32px 32px; box-sizing: border-box;"
playgroundShell is a column with spacing 0, width full
put pgHero, playgroundMount in playgroundShell

put topBar, playgroundShell, siteFooter in app
show app

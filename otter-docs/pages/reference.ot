b1 is a text with value "Otter language reference", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "An index of what Otter supports. Unsupported or experimental syntax is intentionally left out.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Values and variables", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "Text, numbers, booleans, lists, objects, bytes, and gone. Assignment with is; arithmetic with and, minus, times, divided by and make; add and remove.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a link with text "Read values and variables", url "/values/", foreground "#2563eb", weight 600, size 15
b6 is a text with value "Conditions, loops, and functions", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b7 is a text with value "if, otherwise, while, repeat, count, each, to, return, and stop. Comparison words: is, is not, is greater than, is at least, is less than, is at most.", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a link with text "Read conditions", url "/conditions/", foreground "#2563eb", weight 600, size 15
b9 is a link with text "Read loops", url "/loops/", foreground "#2563eb", weight 600, size 15
b10 is a link with text "Read functions", url "/functions/", foreground "#2563eb", weight 600, size 15
b11 is a text with value "Lists, objects, files, and folders", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b12 is a text with value "Lists and collections, property access with of, objects with has, JSON, CSV, file discovery, and explicit file and folder operations.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a link with text "Read lists", url "/lists/", foreground "#2563eb", weight 600, size 15
b14 is a link with text "Read objects and properties", url "/objects/", foreground "#2563eb", weight 600, size 15
b15 is a link with text "Read files and folders", url "/files/", foreground "#2563eb", weight 600, size 15
b16 is a link with text "Read CSV and downloads", url "/data/", foreground "#2563eb", weight 600, size 15
b17 is a text with value "Networking, cryptography, and secrets", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b18 is a text with value "WebSockets, TCP, UDP and TLS; hashing, signing, authenticated encryption and password hashing; and the operating-system credential vault.", size 16, foreground "#3a4d6b", lineheight "1.6"
b19 is a link with text "Read networking", url "/networking/", foreground "#2563eb", weight 600, size 15
b20 is a link with text "Read cryptography and secrets", url "/security/", foreground "#2563eb", weight 600, size 15
b21 is a text with value "Desktop UI, events, and layout", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b22 is a text with value "Create windows and controls, configure them with has, put resources into windows and row or column containers, handle events with when, and show a window:", size 16, foreground "#3a4d6b", lineheight "1.6"
b23 is a text with value "create button into saveButton\nwhen saveButton is clicked\n    say \"Saved\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b23label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b23copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b23head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b23label, b23copy in b23head
b23block is a column with spacing 0, width full
put b23head, b23 in b23block
when b23copy is clicked
    copy text of b23 to clipboard
    text of b23copy is "Copied"
.
b24 is a text with value "State, derived values, and watchers", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b25 is a text with value "Otter supports state, derive, and when a state value changes. Derivations update from their dependencies, and watchers run only when a value actually changes.", size 16, foreground "#3a4d6b", lineheight "1.6"
b26 is a text with value "Web applications", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b27 is a text with value "otter web compiles a program into a standalone HTML, CSS, and JavaScript application. Pages, rows, columns, cards, links, buttons, text, images and more are declared with is a, and drag and drop is available with draggable and accepts drops.", size 16, foreground "#3a4d6b", lineheight "1.6"
b28 is a text with value "Errors and diagnostics", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b29 is a text with value "Use try and otherwise for recoverable work. Otter also provides log, warn, and error for diagnostic output. Every error is a readable Otter message that names the line - never a raw stack trace.", size 16, foreground "#3a4d6b", lineheight "1.6"
b30 is a link with text "Read conditions and errors", url "/conditions/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23block, b24, b25, b26, b27, b28, b29, b30 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

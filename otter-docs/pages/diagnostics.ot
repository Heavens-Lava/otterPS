customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"
customstyle of sideSupport is "display: none;"
customstyle of sideAbout is "display: none;"
customstyle of sideLicense is "display: none;"

b1 is a text with value "Diagnostic Output", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "log, warn, and error send a message to Otter's diagnostic output rather than to the program's normal output.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "log \"Server started.\"\nwarn \"Connection is slow.\"\nerror \"Could not connect.\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b3label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b3copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b3head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b3label, b3copy in b3head
b3block is a column with spacing 0, width full
put b3head, b3 in b3block
when b3copy is clicked
    copy text of b3 to clipboard
    text of b3copy is "Copied"
.
b4 is a text with value "This page is about the log / warn / error statements. It is not about the messages Otter itself prints when a program has a syntax or runtime error — every reference page shows what those look like for the statement it covers.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b5 is a text with value "Diagnostics are not say", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "say is what a program tells the person using it. log, warn, and error are what it tells whoever is running or operating it — a developer watching a console, a log file, a monitoring tool. Otter keeps the two separate on purpose:", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "say \"Welcome!\"\nlog \"Startup complete.\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b7label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b7copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b7head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b7label, b7copy in b7head
b7block is a column with spacing 0, width full
put b7head, b7 in b7block
when b7copy is clicked
    copy text of b7 to clipboard
    text of b7copy is "Copied"
.
b8 is a text with value "A host running Otter can send say output to a user interface while sending diagnostics somewhere else entirely, such as a log file or a monitoring service, without the program needing to know or care. They travel on separate channels.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "Three levels", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "All three take the same kind of message as say — one or more values, joined with a space:", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "port is 8080\nlog \"Listening on port\" port", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b11label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b11copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b11head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11label, b11copy in b11head
b11block is a column with spacing 0, width full
put b11head, b11 in b11block
when b11copy is clicked
    copy text of b11 to clipboard
    text of b11copy is "Copied"
.
b12 is a text with value "log records something that happened normally. warn flags something that is not wrong yet but is worth attention. error reports something that failed.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "A realistic example", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b14 is a text with value "port is 8080\n\nsay \"Otter web server\"\n\nlog \"Starting up.\"\nlog \"Listening on port\" port\nwarn \"No configuration file found, using defaults.\"\nerror \"Could not reach the database.\"\n\nsay \"Ready.\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b14label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b14copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b14head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b14label, b14copy in b14head
b14block is a column with spacing 0, width full
put b14head, b14 in b14block
when b14copy is clicked
    copy text of b14 to clipboard
    text of b14copy is "Copied"
.
b15 is a text with value "Only the say lines are part of what the program is telling its user. The log, warn, and error lines went to the diagnostic channel.", size 16, foreground "#3a4d6b", lineheight "1.6"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3block, b4, b5, b6, b7block, b8, b9, b10, b11block, b12, b13, b14block, b15 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

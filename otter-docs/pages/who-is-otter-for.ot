b1 is a text with value "Who is Otter for?", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter is designed for people who want programs they can read, write and trust - whether or not they have programmed before.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "People new to programming", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "If you have never written code, Otter lets you concentrate on ideas - values, choices, repetition - instead of punctuation. The first program is one line, and every error message tells you what to try next.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "Windows users who automate", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "Renaming files, organizing folders, reading CSV, calling a web service, running other programs and capturing their output: these are plain statements in Otter, without learning a shell language first.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "People building small tools and apps", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "A window with a button, a small web application, an API endpoint, a data viewer. Otter covers desktop and web interfaces with the same readable statements.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "Teachers and learners", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "Because programs read like sentences, a teacher can read a student program aloud and ask what it means. Otter is small enough to learn end to end.", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "Not for everyone, yet", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b12 is a text with value "Otter is not designed for performance-critical systems programming, and its ecosystem of libraries is young. It runs on Windows, macOS and Linux, but desktop windows need Windows: on macOS and Linux, build interfaces as web applications.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a link with text "What can you build?", url "/what-can-you-build/", foreground "#2563eb", weight 600, size 15
b14 is a link with text "Install Otter", url "/installation/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
b20 is a text with value "Using a variable that was never defined is an error, not false and not empty. Otter tells you which name it could not find.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b21 is a link with text "Next: conditions", url "/conditions/", foreground "#2563eb", weight 600, size 15

cmtTitle is a text with value "Comments", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
cmtText is a text with value "A # starts a comment that runs to the end of the line. Comments are for people; Otter ignores them. A # inside quotes is just text.", size 16, foreground "#3a4d6b", lineheight "1.6"
cmtCode is a text with value "# This whole line is a comment.\nage is 29   # so is the end of this line\nsay \"#1 is not a comment\"\nsay age", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
cmtCodelabel is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
cmtCodecopy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
cmtCodehead is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put cmtCodelabel, cmtCodecopy in cmtCodehead
cmtCodeblock is a column with spacing 0, width full
put cmtCodehead, cmtCode in cmtCodeblock
when cmtCodecopy is clicked
    copy text of cmtCode to clipboard
    text of cmtCodecopy is "Copied"
.
cmtNote is a text with value "Good comments explain why, not what: the code already says what.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3block, b4, b5, b6, b7block, b8block, b9, b10, b11block, b12block, b13, b14, b15block, b16block, b17, b18, b19block, b20, cmtTitle, cmtText, cmtCodeblock, cmtNote, b21 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

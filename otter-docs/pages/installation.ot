b1 is a text with value "Installation", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter needs Windows PowerShell 5.1 and nothing else. There are no administrator rights, services, or registry changes.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Release status: {{RELEASE_CHANNEL}} {{RELEASE_VERSION}}. Windows installer: {{INSTALLER_STATUS}}. Until an installer is published, run Otter from the project folder (below).", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b4 is a text with value "System requirements", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b5 is a text with value "Windows 10 or Windows 11 (64-bit) with Windows PowerShell 5.1 (powershell.exe, built into Windows). A standard user account is enough. A web browser is only needed for web applications. Otter runs on Windows PowerShell 5.1; the otter.cmd launcher finds it for you, so you can start Otter from Command Prompt, Windows Terminal, or PowerShell 7 alike.", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "Run from the project folder", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b7 is a text with value "Get the Otter project folder from GitHub, open Windows PowerShell in it, and run a program with otter.cmd:", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "git clone https://github.com/Heavens-Lava/otterPS.git\ncd otterPS\n.\\otter.cmd --version\n.\\otter.cmd examples\\hello.ot", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b9 is a text with value "No registry changes, environment variables, or background services are created. Add the folder to your PATH if you would like to type otter instead of .\\otter.cmd.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "Install from a release archive", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "When a versioned archive is published, extract it, open Windows PowerShell in the extracted folder, and run the per-user installer. It copies Otter to %LOCALAPPDATA%\\Otter, adds it to your user PATH, and runs a health check:", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "Set-ExecutionPolicy -Scope Process Bypass\n.\\Install-Otter.ps1 -AddToUserPath", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b13 is a text with value "Open a new terminal so the updated PATH takes effect, then verify:", size 16, foreground "#3a4d6b", lineheight "1.6"
b14 is a text with value "otter --version", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b15 is a text with value "Otter 1.0.0-rc.1 (Windows PowerShell 5.1)", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b16 is a text with value "Verify your installation", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b17 is a text with value "otter                  # starts the interactive REPL (type exit to leave)\notter check hello.ot   # validates a program without running it", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b18 is a text with value "Troubleshooting", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b19 is a text with value "\"Running scripts is disabled on this system\": allow scripts for the current terminal only with Set-ExecutionPolicy -Scope Process Bypass. It expires when you close the window.", size 16, foreground "#3a4d6b", lineheight "1.6"
b20 is a text with value "\"otter is not recognized\": open a fresh terminal so the new PATH is picked up, and confirm the install folder is in your user PATH.", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a text with value "Uninstall", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b22 is a text with value "Set-ExecutionPolicy -Scope Process Bypass\n& \"$env:LOCALAPPDATA\\Otter\\1.0.0-rc.1\\Uninstall-Otter.ps1\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b23 is a link with text "Next: write your first program", url "/first-program/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
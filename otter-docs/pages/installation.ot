app is a page
    title is "Installation"
    width is 900
    background is "#0f172a"
    spacing is 16
.

siteBrand is a text
    value is "Otter Docs"
    weight is "700"
    foreground is "#f8fafc"
.

siteDocs is a link
    text is "Docs"
    url is "/"
.

siteExamples is a link
    text is "Examples"
    url is "/examples/"
.

siteDownload is a link
    text is "Download"
    url is "/download/"
.

siteNav is a row
    spacing is 16
    padding is 14
    background is "#172554"
    radius is 10
.

put siteBrand, siteDocs, siteExamples, siteDownload in siteNav

heading is a text
    value is "Installation"
    foreground is "#f8fafc"
.

body is a text
    value is "Download Otter for Windows, then run an .ot file from PowerShell with .\\otter.cmd your-program.ot."
    foreground is "#cbd5e1"
.

example is a text
    value is ".\\otter.cmd examples\\hello.ot"
    foreground is "#a7f3d0"
.

home is a link
    text is "Documentation home"
    url is "../"
.

welcome is a link
    text is "Welcome to Otter"
    url is "../welcome/"
.

conditions is a link
    text is "Conditions"
    url is "../conditions/"
.

firstProgram is a link
    text is "Write your first program"
    url is "/first-program/"
.

put siteNav, heading, body, example, firstProgram, home, welcome, conditions in app

searchBox is a text box
    placeholder is "Search documentation..."
    width is 360
.

searchResult is a text
    value is "Search topics: welcome, conditions, values, or loops."
    foreground is "#475569"
.

when searchBox is changed
    query is text of searchBox
    if query contains "welcome"
        text of searchResult is "Result: Welcome to Otter"
    otherwise if query contains "condition"
        text of searchResult is "Result: Conditions"
    otherwise if query contains "value"
        text of searchResult is "Result: Values and Types"
    otherwise if query contains "loop"
        text of searchResult is "Result: Loops"
    otherwise if query contains "object"
        text of searchResult is "Result: Objects (Language Reference)"
    otherwise if query contains "function"
        text of searchResult is "Result: Functions (Language Reference)"
    otherwise if query contains "file"
        text of searchResult is "Result: Files and Folders (Language Reference)"
    otherwise if query contains "string"
        text of searchResult is "Result: Strings (Language Reference)"
    otherwise if query contains "collection"
        text of searchResult is "Result: Collections (Language Reference)"
    otherwise if query contains "web"
        text of searchResult is "Result: Web Development (Examples)"
    otherwise
        text of searchResult is "No matching topic yet."
    .
.

put searchBox, searchResult in app
show app

b1 is a text with value "File and folder objects", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "A discovered file or folder is an object with properties you read with of.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "File Objects", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "A discovered file is an object.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "Common file properties include:", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "say name of file\nsay path of file\nsay extension of file\nsay size of file\nsay created of file\nsay modified of file", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b6label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b6copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b6head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b6label, b6copy in b6head
b6block is a column with spacing 0, width full
put b6head, b6 in b6block
when b6copy is clicked
    copy text of b6 to clipboard
    text of b6copy is "Copied"
.
b7 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "get files in \"Pictures\" into files\n\nfor each file in files\n    say name of file\n    say extension of file\n    say size of file\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b8label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b8copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b8head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b8label, b8copy in b8head
b8block is a column with spacing 0, width full
put b8head, b8 in b8block
when b8copy is clicked
    copy text of b8 to clipboard
    text of b8copy is "Copied"
.

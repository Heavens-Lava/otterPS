b1 is a text with value "Functions", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Define a function with to, followed by its name, its parameters, and an indented body.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "to greet person\n    say \"Hello,\" person\n.\n\ngreet \"Ada\"\ngreet \"Linus\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b3label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b3copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b3head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b3label, b3copy in b3head
b3block is a column with spacing 0, width full
put b3head, b3 in b3block
when b3copy is clicked
    copy text of b3 to clipboard
    text of b3copy is "Copied"
.
b4 is a text with value "Hello, Ada\nHello, Linus", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b4label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b4copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Return values", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "to calculateTax subtotal and rate\n    subtotal times rate make tax\n    return tax\n.\n\n# Option A: using make\ncalculateTax 100 and 0.08 make taxAmount\nsay \"Tax on $100:\" taxAmount\n\n# Option B: using is\ntaxAmount2 is calculateTax 200 and 0.05\nsay \"Tax on $200:\" taxAmount2", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b6label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b6copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b6head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b6label, b6copy in b6head
b6block is a column with spacing 0, width full
put b6head, b6 in b6block
when b6copy is clicked
    copy text of b6 to clipboard
    text of b6copy is "Copied"
.
b7 is a text with value "Tax on $100: 8\nTax on $200: 10", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b7label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b7copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b7head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b7label, b7copy in b7head
b7block is a column with spacing 0, width full
put b7head, b7 in b7block
when b7copy is clicked
    copy text of b7 to clipboard
    text of b7copy is "Copied"
.
b8 is a text with value "Scope", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b9 is a text with value "Every call gets its own scope. Parameters never overwrite variables outside the function:", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "name is \"Outside\"\n\nto greet name\n    say \"Hello\" name\n.\n\ngreet \"Jeff\"\nsay name", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b10label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b10copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b10head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b10label, b10copy in b10head
b10block is a column with spacing 0, width full
put b10head, b10 in b10block
when b10copy is clicked
    copy text of b10 to clipboard
    text of b10copy is "Copied"
.
b11 is a text with value "Hello Jeff\nOutside", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b11label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b11copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b11head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11label, b11copy in b11head
b11block is a column with spacing 0, width full
put b11head, b11 in b11block
when b11copy is clicked
    copy text of b11 to clipboard
    text of b11copy is "Copied"
.
b11a is a text with value "Arguments are single values", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11b is a text with value "Each argument is one value: a number, a piece of text, a variable or a property. A call takes exactly as many values as the function has parameters, so factorial n minus 1 means (factorial n) minus 1, not the factorial of n minus 1, and that call would never end. Put a calculation in a variable first, then pass the variable. A function must also be defined above the line that calls it.", size 16, foreground "#3a4d6b", lineheight "1.6"
b11c is a text with value "to factorial n\n    if n is at most 1\n        return 1\n    .\n    m is n minus 1\n    rest is factorial m\n    return n times rest\n.\n\nsay factorial 5", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b11clabel is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b11ccopy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b11chead is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11clabel, b11ccopy in b11chead
b11cblock is a column with spacing 0, width full
put b11chead, b11c in b11cblock
when b11ccopy is clicked
    copy text of b11c to clipboard
    text of b11ccopy is "Copied"
.
b11d is a text with value "120", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b11dlabel is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b11dcopy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b11dhead is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11dlabel, b11dcopy in b11dhead
b11dblock is a column with spacing 0, width full
put b11dhead, b11d in b11dblock
when b11dcopy is clicked
    copy text of b11d to clipboard
    text of b11dcopy is "Copied"
.
b12 is a text with value "stop ends a function early. Larger programs can be split across files with use \"other.ot\".", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a link with text "Next: objects and properties", url "/objects/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3block, b4block, b5, b6block, b7block, b8, b9, b10block, b11block, b11a, b11b, b11cblock, b11dblock, b12, b13 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

b27 is a text with value "Common mistakes", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b28 is a text with value "- A property is written property of thing (name of person), never person.name.", size 16, foreground "#3a4d6b", lineheight "1.6"
b29 is a text with value "- A block ends with a period on its own line. A period is never used for anything else.", size 16, foreground "#3a4d6b", lineheight "1.6"
b30 is a text with value "- Some words Otter uses in statements, such as percent, cannot be variable names. Pick another (rate instead of percent).", size 16, foreground "#3a4d6b", lineheight "1.6"
b31 is a text with value "- One calculation per statement: bill times rate make product, then product divided by 100 make tip.", size 16, foreground "#3a4d6b", lineheight "1.6"
b32 is a text with value "Reporting a problem", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b33 is a text with value "If Otter reports \"a bug in Otter\", or a message is unclear, please open an issue with the smallest program that shows it, the exact message, your Otter version (otter --version), and your Windows version.", size 16, foreground "#3a4d6b", lineheight "1.6"
b34 is a link with text "Open an issue on GitHub", url "https://github.com/Heavens-Lava/otterPS/issues", foreground "#2563eb", weight 600, size 15
b35 is a link with text "The otter command", url "/cli/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
nw1 is a text with value "Messages from the Otter 1.0 rules", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
nw2 is a text with value "These come from rules added for Otter 1.0. Each message below is exactly what otter prints.", size 16, foreground "#3a4d6b", lineheight "1.6"
nw3 is a text with value "Otter Syntax Error\n\nLine 1:\n    to find name\n       ^\n\n`find` is a reserved word in Otter: a line starting with `find` is read as the `find` statement, so a function named `find` could never be called. Choose a different name, for example `findTask`.\n\nTry:\n    Rename `find` everywhere it is used, for example to `findTask`. See docs/OTTER_1_0_RESERVED_WORDS.md.", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
nw3label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
nw3copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
nw3head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put nw3label, nw3copy in nw3head
nw3block is a column with spacing 0, width full
put nw3head, nw3 in nw3block
when nw3copy is clicked
    copy text of nw3 to clipboard
    text of nw3copy is "Copied"
.
nw4 is a text with value "Fix: use the suggested name, or any other name that is not reserved. The Reference page lists the reserved words.", size 16, foreground "#3a4d6b", lineheight "1.6"
nw5 is a text with value "Otter Runtime Error\n\nLine 2:\n    message is \"total: \" and total\n\nI expected a number for the left side of this calculation but got \"total: \".", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
nw5label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
nw5copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
nw5head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put nw5label, nw5copy in nw5head
nw5block is a column with spacing 0, width full
put nw5head, nw5 in nw5block
when nw5copy is clicked
    copy text of nw5 to clipboard
    text of nw5copy is "Copied"
.
nw6 is a text with value "Fix: and joins two pieces of text, but it cannot join text and a number. To show them together, give say the parts: say \"total:\" total prints total: 3.", size 16, foreground "#3a4d6b", lineheight "1.6"
nw7 is a text with value "Otter Syntax Error\n\nLine 2:\n    if score is 1 plus score is 4\n                             ^\n\nI expected the statement to end here. I found 'is' instead.\n\nTry:\n    Check the expected word and try again.", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
nw7label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
nw7copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
nw7head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put nw7label, nw7copy in nw7head
nw7block is a column with spacing 0, width full
put nw7head, nw7 in nw7block
when nw7copy is clicked
    copy text of nw7 to clipboard
    text of nw7copy is "Copied"
.
nw8 is a text with value "Fix: join two conditions with and, as in if score is 1 and score is 4. plus is always arithmetic, even inside an if.", size 16, foreground "#3a4d6b", lineheight "1.6"
nw9 is a text with value "Otter Runtime Error\n\nLine 1:\n    hide sidebar\n\n'hide' is not supported in Otter 1.0.", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
nw9label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
nw9copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
nw9head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"

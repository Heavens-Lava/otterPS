    text of nw11copy is "Copied"
.
nw12 is a text with value "Fix: a browser cannot start programs, and some other statements need the computer as well. Run that program with otter run instead of otter web.", size 16, foreground "#3a4d6b", lineheight "1.6"
nw13 is a text with value "Otter Syntax Error\n\nLine 1:\n    use \"helpers.ot\"\n    ^\n\nThe file is named \"Helpers.ot\", but this use says \"helpers.ot\". Module paths must match file and folder names exactly, including capital letters.\n\nTry:\n    use \"Helpers.ot\"", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
nw13label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
nw13copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
nw13head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put nw13label, nw13copy in nw13head
nw13block is a column with spacing 0, width full
put nw13head, nw13 in nw13block
when nw13copy is clicked
    copy text of nw13 to clipboard
    text of nw13copy is "Copied"
.
nw14 is a text with value "Fix: write file and folder names exactly as they are, including capital letters, so the program works the same on every computer. The message shows the corrected line.", size 16, foreground "#3a4d6b", lineheight "1.6"

put b1, b2, b3, b4, b5block, b6, b7block, b8, b9, b10, b11block, b12, b13, b14, b15block, b16, b17block, b18, b19block, b20, b21block, b22, b23, b24block, b25, b26block, nw1, nw2, nw3block, nw4, nw5block, nw6, nw7block, nw8, nw9block, nw10, nw11block, nw12, nw13block, nw14, b27, b28, b29, b30, b31, b32, b33, b34, b35 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

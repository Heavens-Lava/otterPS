b1 is a text with value "button", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Something the person clicks. There are four kinds: button, primary button, secondary button and danger button. They behave the same and differ in how they look.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Syntax", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "create button into name\ncreate primary button into name\ncreate secondary button into name\ncreate danger button into name", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b4label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b4copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Properties", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "text        text     What the control shows\nwidth       number   Width in pixels\nheight      number   Height in pixels\nbackground  color    Background color: a name (\"navy\") or a hex value (\"#2563eb\")\nforeground  color    Text color, written the same way\nalign       word     left, center or right (rows and columns also accept top, middle, bottom)", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b6label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b6copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b6head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b6label, b6copy in b6head
b6block is a column with spacing 0, width full
put b6head, b6 in b6block
when b6copy is clicked
    copy text of b6 to clipboard
    text of b6copy is "Copied"
.
b7 is a text with value "Events", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "clicked   runs when the button is clicked (click means the same)", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b8label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b8copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b8head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b8label, b8copy in b8head
b8block is a column with spacing 0, width full
put b8head, b8 in b8block
when b8copy is clicked
    copy text of b8 to clipboard
    text of b8copy is "Copied"
.
b9 is a text with value "Example", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "clicks is 0\n\ncreate window into app\ntitle of app is \"Counter\"\n\ncreate text into display\ntext of display is \"0\"\n\ncreate primary button into addButton\ntext of addButton is \"Add one\"\n\ncreate danger button into resetButton\ntext of resetButton is \"Reset\"\n\nput display in app\nput addButton in app\nput resetButton in app\n\nwhen addButton is clicked\n    increase clicks\n    text of display is clicks\n.\n\nwhen resetButton is clicked\n    clicks is 0\n    text of display is clicks\n.\n\nshow app", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b10label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b10copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b10head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b10label, b10copy in b10head
b10block is a column with spacing 0, width full
put b10head, b10 in b10block
when b10copy is clicked
    copy text of b10 to clipboard
    text of b10copy is "Copied"
.
b11 is a text with value "Expected result", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b12 is a text with value "A window with the number 0 and two buttons. Add one raises the number; Reset sets it back to zero.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a link with text "text", url "/control-text/", foreground "#2563eb", weight 600, size 15
b14 is a link with text "Events", url "/events/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4block, b5, b6block, b7, b8block, b9, b10block, b11, b12, b13, b14 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

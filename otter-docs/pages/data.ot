b1 is a text with value "CSV and downloads", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter reads and writes RFC 4180 CSV natively. Each column header becomes a property of a row object.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "rawCsv is \"id,city,temp\\n101,Seattle,68\\n102,Portland,72\\n103,Spokane,75\"\n\nconvert rawCsv from csv into records\n\nsay \"Loaded\" length of records \"weather records:\"\neach row in records\n    say \"  City:\" city of row \"High:\" temp of row\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b3label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b3copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b3head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b3label, b3copy in b3head
b3block is a column with spacing 0, width full
put b3head, b3 in b3block
when b3copy is clicked
    copy text of b3 to clipboard
    text of b3copy is "Copied"
.
b4 is a text with value "Loaded 3 weather records:\n  City: Seattle High: 68\n  City: Portland High: 72\n  City: Spokane High: 75", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b4label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b4copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Reading and writing CSV files", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "filePath is \"weather.csv\"\n\nwrite csv records to filePath\nread csv from filePath into loadedData\nsay \"Verified\" length of loadedData \"rows read from disk.\"\n\ndelete file filePath", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b6label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b6copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b6head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b6label, b6copy in b6head
b6block is a column with spacing 0, width full
put b6head, b6 in b6block
when b6copy is clicked
    copy text of b6 to clipboard
    text of b6copy is "Copied"
.
b7 is a text with value "Downloading files", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "download streams a file from an HTTP or HTTPS address to a local path:", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "url is \"https://httpbin.org/robots.txt\"\ndest is \"robots.txt\"\n\ndownload file from url to dest\n\nif file dest exists\n    read dest into text\n    say \"Downloaded\" length of text \"bytes.\"\n    delete file dest\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b9label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b9copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b9head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b9label, b9copy in b9head
b9block is a column with spacing 0, width full
put b9head, b9 in b9block
when b9copy is clicked
    copy text of b9 to clipboard
    text of b9copy is "Copied"
.
b10 is a text with value "Built-in download safety", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "Otter never silently overwrites an existing file - the download stops before making any network request. Data streams into a hidden temporary file and is renamed into place only after every byte arrives. If the connection drops or the transfer is truncated, the partial file is removed.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a link with text "Next: networking", url "/networking/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3block, b4block, b5, b6block, b7, b8, b9block, b10, b11, b12 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

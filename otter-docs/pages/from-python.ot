b1 is a text with value "Coming from Python", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "If you know Python, most of Otter will feel familiar: the same ideas, written in words. Each pair below shows the Python first, then the Otter that does the same thing, then what both print.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Variables and printing", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
py1 is a text with value "name = \"Sam\"\nage = 12\nprint(\"Hello\", name)\nprint(age + 1)", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
py1label is a text with value "Python", size 12, weight 600, foreground "#b7c4d8"
py1copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
py1head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put py1label, py1copy in py1head
py1block is a column with spacing 0, width full
put py1head, py1 in py1block
when py1copy is clicked
    copy text of py1 to clipboard
    text of py1copy is "Copied"
.

b1 is a text with value "Privacy", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter does not collect, send or sell any information about you or the programs you write. This page covers the Otter programming language (the download, the Microsoft Store app and the otter command) and this website. Last updated 14 October 2026.", size 18, foreground "#3a4d6b", lineheight "1.6"
b3 is a text with value "The Otter language and tools", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "- Otter has no telemetry, analytics or crash reporting. It never contacts a server on its own.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "- Your programs, your files and everything they produce stay on your computer. Otter keeps a cache of compiled programs in your own user folder (on Windows, %LOCALAPPDATA%\Otter\cache) so they start faster; it never leaves your computer and you can delete it at any time.", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "- A program you write can use the network, files, the clipboard or stored passwords because you told it to. That is your program acting for you, not Otter collecting data.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "This website", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "- The website uses no cookies, no analytics and no tracking, and loads nothing from other sites.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "- It is hosted by GitHub Pages. Like any web host, GitHub may record technical information such as IP addresses in its server logs; see the GitHub Privacy Statement.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "Downloads and the Microsoft Store", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "- The download is served by GitHub Releases, and the Store app by Microsoft. Their own privacy statements cover what they record when you download or install.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "Contact", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b13 is a text with value "Questions about privacy: open an issue on GitHub (github.com/Heavens-Lava/otterPS/issues).", size 16, foreground "#3a4d6b", lineheight "1.6"
b14 is a link with text "GitHub Privacy Statement", url "https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement", foreground "#2563eb", weight 600, size 15
b15 is a link with text "License", url "/license/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
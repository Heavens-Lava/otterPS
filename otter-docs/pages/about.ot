# Otter website - About Otter
# Authored in Otter. Scaffolded by scripts/new-docs-page.ps1, now edited here directly.

use "_shell.ot"
use "_docs.ot"

app is a page with title "About Otter - Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navDocs is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"
customstyle of sideAbout is "padding: 8px 12px; border-left: 3px solid #2563eb; border-radius: 4px; display: block; background: #e6efff; color: #1d4ed8; font-weight: 600;"
# Sidebar: only the current group is expanded.
customstyle of sideDocs is "display: none;"
customstyle of sideWelcome is "display: none;"
customstyle of sideWhatIsOtter is "display: none;"
customstyle of sideWhoIsOtterFor is "display: none;"
customstyle of sideWhatCanYouBuild is "display: none;"
customstyle of sideInstallation is "display: none;"
customstyle of sideVerify is "display: none;"
customstyle of sideFirstProgram is "display: none;"
customstyle of sideHello is "display: none;"
customstyle of sideRepl is "display: none;"
customstyle of sideRunningFiles is "display: none;"
customstyle of sideTinyApp is "display: none;"
customstyle of sideCli is "display: none;"
customstyle of sideProjects is "display: none;"
customstyle of sideTroubleshooting is "display: none;"
customstyle of sideValues is "display: none;"
customstyle of sideInputOutput is "display: none;"
customstyle of sideConditions is "display: none;"
customstyle of sideLoops is "display: none;"
customstyle of sideLists is "display: none;"
customstyle of sideFunctions is "display: none;"
customstyle of sideObjects is "display: none;"
customstyle of sideFiles is "display: none;"
customstyle of sideData is "display: none;"
customstyle of sideErrorHandling is "display: none;"
customstyle of sideMath is "display: none;"
customstyle of sideNestedConditions is "display: none;"
customstyle of sideModules is "display: none;"
customstyle of sideRunningPrograms is "display: none;"
customstyle of sideLoggingDebugging is "display: none;"
customstyle of sideEnvironment is "display: none;"
customstyle of sideGone is "display: none;"
customstyle of sideOperators is "display: none;"
customstyle of sidePropertyAccess is "display: none;"
customstyle of sideStrings is "display: none;"
customstyle of sideCollections is "display: none;"
customstyle of sideDiscovery is "display: none;"
customstyle of sideFileObjects is "display: none;"
customstyle of sideFilesFolders is "display: none;"
customstyle of sideFolders is "display: none;"
customstyle of sideTry is "display: none;"
customstyle of sideJson is "display: none;"
customstyle of sideRandom is "display: none;"
customstyle of sideDates is "display: none;"
customstyle of sideScope is "display: none;"
customstyle of sideDiagnostics is "display: none;"
customstyle of sideReference is "display: none;"
customstyle of sideDatabases is "display: none;"
customstyle of sideQueries is "display: none;"
customstyle of sideHttp is "display: none;"
customstyle of sideWebServer is "display: none;"
customstyle of sideXml is "display: none;"
customstyle of sideWebApps is "display: none;"
customstyle of sideReactivity is "display: none;"
customstyle of sideWindowsApps is "display: none;"
customstyle of sideNetworking is "display: none;"
customstyle of sideSecurity is "display: none;"
customstyle of sideExamples is "display: none;"
customstyle of sideExampleHello is "display: none;"
customstyle of sideExampleInput is "display: none;"
customstyle of sideExampleConditions is "display: none;"
customstyle of sideExampleCounting is "display: none;"
customstyle of sideExampleLists is "display: none;"
customstyle of sideExampleDiscovery is "display: none;"
customstyle of sideExampleOrganizer is "display: none;"
customstyle of sideExampleFinding is "display: none;"
customstyle of sideExampleErrors is "display: none;"
customstyle of sideDesignReadable is "display: none;"
customstyle of sideStructuralWords is "display: none;"
customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"

b1 is a text with value "About Otter", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter is a programming language designed so that a program can be understood when it is read aloud.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Otter was created by Jeffrey Macy. It is written in Windows PowerShell 5.1, and it runs on the PowerShell that is already part of Windows 10 and Windows 11.", size 16, foreground "#3a4d6b", lineheight "1.6"
b4 is a text with value "The idea", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b5 is a text with value "Most languages ask you to learn punctuation before you can express an idea. Otter asks for the idea. Statements read as sentences, blocks end with a period, and each statement has exactly one meaning, so a beginner can read a program aloud and know what it does - and the computer can read it exactly one way.", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "age is 20\nif age is at least 18\n    say \"Adult\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b6label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b6copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b6head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b6label, b6copy in b6head
b6block is a column with spacing 0, width full
put b6head, b6 in b6block
when b6copy is clicked
    copy text of b6 to clipboard
    text of b6copy is "Copied"
.
b7 is a text with value "What Otter is today", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "Otter is a pre-release, version {{RELEASE_VERSION}}. The language, the command-line tools, desktop and web application support, and the standard library are all in active use. Otter runs on Windows only for now.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "Design philosophy", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "The reasoning behind the language - why properties use of, why a period only ever ends a block, why one canonical spelling beats many - is written down.", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a link with text "Readable like English", url "/design-readable/", foreground "#2563eb", weight 600, size 15
b12 is a link with text "Structural words", url "/structural-words/", foreground "#2563eb", weight 600, size 15
b13 is a link with text "Period and block rules", url "/periods/", foreground "#2563eb", weight 600, size 15
b14 is a link with text "Philosophy", url "/philosophy/", foreground "#2563eb", weight 600, size 15
b15 is a text with value "License and credits", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b16 is a text with value "Otter is free to use, including for commercial software. See the license page for exactly what you can and cannot do.", size 16, foreground "#3a4d6b", lineheight "1.6"
b17 is a link with text "The Otter Free Use License", url "/license/", foreground "#2563eb", weight 600, size 15
b18 is a link with text "Third-party notices", url "https://github.com/Heavens-Lava/otterPS/blob/master/THIRD-PARTY-NOTICES.md", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6block, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

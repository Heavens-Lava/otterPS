# Otter website - Download
# Authored in Otter and compiled with the site build (build-otter-pages.ps1).
# Release facts come from release-data.json through the {{...}} tokens, so this
# page can only say what is true: the installer is not published yet.

use "_shell.ot"

app is a page with title "Download Otter", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navDownload is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"

# ==========================================
# 1. HERO
# ==========================================

heroEyebrow is a text with value "{{RELEASE_CHANNEL}} {{RELEASE_VERSION}}", size 13, weight 700, foreground "#7fb0ff", letterspacing "0.08em"
heroTitle is a text with value "Download Otter", size 48, weight 800, foreground "#ffffff", letterspacing "-0.03em", lineheight "1.05"
heroLead is a text with value "Get the latest version of Otter and start building today.", size 20, foreground "#f1f6ff"
heroNote is a text with value "Otter is free, open source, and runs on Windows with the PowerShell already on your machine.", size 15, foreground "#d2e1f5"
heroGetSource is a link with text "Get Otter from GitHub", url "https://github.com/Heavens-Lava/otterPS", foreground "#ffffff", weight 700, size 17, background "#2675ed", radius 12, customstyle "padding: 17px 30px; display: inline-block; box-shadow: 0 10px 22px rgba(0,89,230,.28);"
heroInstaller is a text with value "Windows installer: {{INSTALLER_STATUS}}", size 13, foreground "#f5c46b"
heroActions is a row with spacing 18, align middle, margin "8px 0 0 0"
put heroGetSource, heroInstaller in heroActions
heroCopy is a column with spacing 14, flex 1, customstyle "padding-bottom: 88px;"
put heroEyebrow, heroTitle, heroLead, heroNote, heroActions in heroCopy
heroMascot is a image with source "/static/images/otter-download-hero-mascot.png", alt "The Otter mascot standing on a rock", height 340, customstyle "display: block; margin-bottom: -30px;"
heroBody is a row with spread, align middle, spacing 40, width full, padding "48px 48px 0", customstyle "box-sizing: border-box; align-items: flex-end; max-width: 1240px; margin: 0 auto;"
put heroCopy, heroMascot in heroBody
hero is a column with width full, background "#0b1d36", spacing 0, customstyle "background-image: linear-gradient(90deg, rgba(7,24,50,.94) 0%, rgba(7,24,50,.70) 48%, rgba(7,24,50,.12) 100%), url('/static/images/otter-download-mountain-backdrop.png'); background-size: cover; background-position: center; overflow: hidden;"
put topBar, heroBody in hero

# ==========================================
# 2. PLATFORM TABS
# ==========================================

tabWindows is a text with value "▣  Windows", size 16, weight 700, foreground "#1d70ea", background "#f8fbff", radius 10, border "2px solid #b9d7ff", flex 1, customstyle "text-align: center; padding: 14px;"
tabMac is a text with value "●  macOS - not yet", size 16, weight 600, foreground "#687994", flex 1, customstyle "text-align: center; padding: 14px;"
tabLinux is a text with value "♙  Linux - not yet", size 16, weight 600, foreground "#687994", flex 1, customstyle "text-align: center; padding: 14px;"
tabSource is a link with text "Source", url "https://github.com/Heavens-Lava/otterPS", foreground "#0f1f36", weight 600, size 16, flex 1, customstyle "text-align: center; padding: 14px;"
tabs is a row with spacing 14, align middle, width full, background "#ffffff", border "1px solid #e3e9f2", radius 16, padding 10, shadow "0 8px 24px rgba(11,29,54,0.10)", customstyle "box-sizing: border-box; margin-top: -30px; position: relative;"
put tabWindows, tabMac, tabLinux, tabSource in tabs

# ==========================================
# 3. WINDOWS DOWNLOAD + REQUIREMENTS
# ==========================================

dlTitle is a text with value "Windows download", size 26, weight 800, foreground "#0f1f36", letterspacing "-0.02em"
dlStatus is a text with value "{{INSTALLER_STATUS}}", size 18, weight 700, foreground "#b45309"
dlBody is a text with value "A signed installer will appear here when it is published. Until then, run Otter straight from the project folder - it needs nothing else installed.", size 15, foreground "#4a5b75", lineheight "1.55"
dlGuide is a link with text "Read the installation guide", url "/installation/", foreground "#2563eb", weight 600, size 15
dlRelease is a link with text "View release readiness", url "/release/", foreground "#2563eb", weight 600, size 15
dlLinks is a row with spacing 24, align middle
put dlGuide, dlRelease in dlLinks
dlCard is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 28, spacing 14, flex 1.55
dlText is a column with spacing 14, flex 1
put dlTitle, dlStatus, dlBody, dlLinks in dlText
winMascot is a image with source "/static/images/otter-windows-download-mascot.png", alt "The Otter mascot holding a Windows logo", height 170
dlRow is a row with spread, align middle, spacing 24, width full
put dlText, winMascot in dlRow
put dlRow in dlCard

reqTitle is a text with value "System requirements", size 26, weight 800, foreground "#0f1f36", letterspacing "-0.02em"
reqOsLabel is a text with value "Operating system", size 13, weight 700, foreground "#0f1f36"
reqOs is a text with value "Windows 10 or Windows 11, 64-bit", size 14, foreground "#4a5b75"
reqShellLabel is a text with value "Shell", size 13, weight 700, foreground "#0f1f36"
reqShell is a text with value "Windows PowerShell 5.1 (built into Windows)", size 14, foreground "#4a5b75"
reqRightsLabel is a text with value "Privileges", size 13, weight 700, foreground "#0f1f36"
reqRights is a text with value "A standard user account. No administrator rights.", size 14, foreground "#4a5b75"
reqDepsLabel is a text with value "Additional software", size 13, weight 700, foreground "#0f1f36"
reqDeps is a text with value "None. A browser is only needed for web applications.", size 14, foreground "#4a5b75"
reqCard is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 28, spacing 8, flex 1
put reqTitle, reqOsLabel, reqOs, reqShellLabel, reqShell, reqRightsLabel, reqRights, reqDepsLabel, reqDeps in reqCard

topCards is a row with spacing 24, align top, width full
put dlCard, reqCard in topCards

# ==========================================
# 4. RELEASE DETAILS
# ==========================================

relTitle is a text with value "Release details", size 26, weight 800, foreground "#0f1f36", letterspacing "-0.02em"
relVersion is a text with value "Version: {{RELEASE_VERSION}} ({{RELEASE_CHANNEL}})", size 15, foreground "#4a5b75"
relSize is a text with value "Installer size: {{INSTALLER_SIZE}}", size 15, foreground "#4a5b75"
relDate is a text with value "Release date: {{RELEASE_DATE}}", size 15, foreground "#4a5b75"
relSha is a text with value "SHA-256: {{SHA256}}", size 15, foreground "#4a5b75"
relNotes is a text with value "Release notes: {{RELEASE_NOTES_STATUS}}", size 15, foreground "#4a5b75"
relCard is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 28, spacing 8, width full
put relTitle, relVersion, relSize, relDate, relSha, relNotes in relCard

# ==========================================
# 5. RUN FROM THE PROJECT FOLDER
# ==========================================

runTitle is a text with value "Run from the project folder", size 26, weight 800, foreground "#0f1f36", letterspacing "-0.02em"
runBody is a text with value "Open Windows PowerShell in the folder that contains otter.cmd, then run an example:", size 15, foreground "#4a5b75"
runCommand is a text with value ".\\otter.cmd examples\\hello.ot", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
runCommandlabel is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
runCommandcopy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
runCommandhead is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put runCommandlabel, runCommandcopy in runCommandhead
runCommandblock is a column with spacing 0, width full
put runCommandhead, runCommand in runCommandblock
when runCommandcopy is clicked
    copy text of runCommand to clipboard
    text of runCommandcopy is "Copied"
.
runResult is a text with value "Hello, Otter!", size 14, foreground "#a5e3b5", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
runResultlabel is a text with value "Output", size 12, weight 600, foreground "#b7c4d8"
runResultcopy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
runResulthead is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put runResultlabel, runResultcopy in runResulthead
runResultblock is a column with spacing 0, width full
put runResulthead, runResult in runResultblock
when runResultcopy is clicked
    copy text of runResult to clipboard
    text of runResultcopy is "Copied"
.
runCard is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 28, spacing 12, flex 1.55
put runTitle, runBody, runCommandblock, runResultblock in runCard

nextTitle is a text with value "Next steps", size 26, weight 800, foreground "#0f1f36", letterspacing "-0.02em"
nextOne is a link with text "1. Install Otter", url "/installation/", foreground "#2563eb", size 15
nextTwo is a link with text "2. Write your first program", url "/first-program/", foreground "#2563eb", size 15
nextThree is a link with text "3. Explore the documentation", url "/", foreground "#2563eb", size 15
nextFour is a link with text "4. Try the examples", url "/examples/", foreground "#2563eb", size 15
nextCard is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 28, spacing 12, flex 1
put nextTitle, nextOne, nextTwo, nextThree, nextFour in nextCard

bottomCards is a row with spacing 24, align top, width full
put runCard, nextCard in bottomCards

# ==========================================
# 6. PAGE
# ==========================================

content is a column with spacing 24, width full, padding "0 56px", customstyle "box-sizing: border-box; max-width: 1240px; margin: 0 auto;"
put tabs, topCards, relCard, bottomCards in content

put hero, content, siteFooter in app
show app

# Otter website - Scope
# Authored in Otter. Scaffolded by scripts/new-docs-page.ps1, now edited here directly.

use "_shell.ot"
use "_docs.ot"

app is a page with title "Scope - Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navDocs is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"
customstyle of sideScope is "padding: 8px 12px; border-left: 3px solid #2563eb; border-radius: 4px; display: block; background: #e6efff; color: #1d4ed8; font-weight: 600;"
# Sidebar: only the current group is expanded.
customstyle of sideHome is "display: none;"
customstyle of sideWelcome is "display: none;"
customstyle of sideInstallation is "display: none;"
customstyle of sideFirstProgram is "display: none;"
customstyle of sideHello is "display: none;"
customstyle of sideRunningFiles is "display: none;"
customstyle of sideRepl is "display: none;"
customstyle of sideCli is "display: none;"
customstyle of sideValues is "display: none;"
customstyle of sideInputOutput is "display: none;"
customstyle of sideConditions is "display: none;"
customstyle of sideLoops is "display: none;"
customstyle of sideLists is "display: none;"
customstyle of sideFunctions is "display: none;"
customstyle of sideObjects is "display: none;"
customstyle of sideFiles is "display: none;"
customstyle of sideData is "display: none;"
customstyle of sideErrorHandling is "display: none;"
customstyle of sideMath is "display: none;"
customstyle of sideNestedConditions is "display: none;"
customstyle of sideModules is "display: none;"
customstyle of sideRunningPrograms is "display: none;"
customstyle of sideLoggingDebugging is "display: none;"
customstyle of sideEnvironment is "display: none;"
customstyle of sideDatabases is "display: none;"
customstyle of sideQueries is "display: none;"
customstyle of sideHttp is "display: none;"
customstyle of sideWebServer is "display: none;"
customstyle of sideXml is "display: none;"
customstyle of sideWebApps is "display: none;"
customstyle of sideReactivity is "display: none;"
customstyle of sideWindowsApps is "display: none;"
customstyle of sideNetworking is "display: none;"
customstyle of sideSecurity is "display: none;"
customstyle of sideExamples is "display: none;"
customstyle of sideExampleHello is "display: none;"
customstyle of sideExampleInput is "display: none;"
customstyle of sideExampleConditions is "display: none;"
customstyle of sideExampleCounting is "display: none;"
customstyle of sideExampleLists is "display: none;"
customstyle of sideExampleDiscovery is "display: none;"
customstyle of sideExampleOrganizer is "display: none;"
customstyle of sideExampleFinding is "display: none;"
customstyle of sideExampleErrors is "display: none;"
customstyle of sideDesignReadable is "display: none;"
customstyle of sideStructuralWords is "display: none;"
customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"

b1 is a text with value "Scope", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Where a variable can be seen: everywhere, inside one function, or inside one block.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Variable Scope", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "Otter must define where variables can be accessed.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "name is \"Jeff\"\n\nto greet\n    message is \"Hello\"\n    say name\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b7 is a text with value "The language must specify:", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "- whether functions can read variables outside themselves", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "- whether local variables disappear when the function ends", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "- whether nested blocks create new scopes", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "- how outer variables are changed deliberately", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "The preferred rule is:", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "Variables created inside a function belong to that function unless explicitly exposed.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b14 is a text with value "Function Local Variables", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b15 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b16 is a text with value "to greet name\n    message is \"Hello\"\n    say message name\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b17 is a text with value "message exists only while greet is running.", size 16, foreground "#3a4d6b", lineheight "1.6"
b18 is a text with value "After the function finishes, message should no longer be available outside that function.", size 16, foreground "#3a4d6b", lineheight "1.6"
b19 is a text with value "Block Scope", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b20 is a text with value "Simple control-flow blocks should not automatically hide ordinary variables unless Otter later chooses strict lexical block scope.", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b22 is a text with value "if ready\n    message is \"Starting\"\n.\n\nsay message", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b23 is a text with value "This behavior needs one consistent rule across:", size 16, foreground "#3a4d6b", lineheight "1.6"
b24 is a text with value "if\nwhile\nfor each\ncount\ntry", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b25 is a text with value "The exact rule should be frozen before more advanced closures or concurrency are added.", size 16, foreground "#3a4d6b", lineheight "1.6"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
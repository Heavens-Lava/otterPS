b1 is a text with value "Projects", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "A project is a folder with an otter.json manifest. Otter can create one, check it, test it, run it, build it and package it.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Create a project", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "otter new console my-app", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b4label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b4copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Created new Otter console project in \"C:\\Users\\you\\my-app\".\n\nTo get started:\n  cd my-app\n  otter check .\n  otter test .\n  otter run .", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b5label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b5copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b5head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b5label, b5copy in b5head
b5block is a column with spacing 0, width full
put b5head, b5 in b5block
when b5copy is clicked
    copy text of b5 to clipboard
    text of b5copy is "Copied"
.
b6 is a text with value "The type is one of console, desktop, web, automation or game. A new console project contains:", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "my-app/\n  main.ot            the entry point\n  otter.json         the project manifest\n  src/               your own modules\n  assets/            files the project ships with\n  tests/app_test.ot  a starter test", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b7label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b7copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b7head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b7label, b7copy in b7head
b7block is a column with spacing 0, width full
put b7head, b7 in b7block
when b7copy is clicked
    copy text of b7 to clipboard
    text of b7copy is "Copied"
.
b8 is a text with value "The manifest", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b9 is a text with value "{\n  \"name\": \"my-app\",\n  \"version\": \"0.1.0\",\n  \"archetype\": \"console\",\n  \"target\": \"console\",\n  \"entryPoint\": \"main.ot\",\n  \"assets\": [],\n  \"build\": { \"outputDir\": \"dist\", \"clean\": true },\n  \"scripts\": {\n    \"start\": \"otter run .\",\n    \"test\": \"otter test .\",\n    \"check\": \"otter check .\"\n  }\n}", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b9label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b9copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b9head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b9label, b9copy in b9head
b9block is a column with spacing 0, width full
put b9head, b9 in b9block
when b9copy is clicked
    copy text of b9 to clipboard
    text of b9copy is "Copied"
.
b9a is a text with value "otter.json is the Otter 1.0 manifest. An older project.json is read only when a folder has no otter.json; when both exist, otter.json wins. entryPoint and every asset must stay inside the project folder, and publishing needs a name and a plain version string such as 1.2.0. The project manifest specification lists every field, its type and default, and which commands use it.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9b is a link with text "Project manifest specification", url "https://github.com/Heavens-Lava/otterPS/blob/master/docs/OTTER_1_0_PROJECT_MANIFEST.md", foreground "#2563eb", weight 600, size 15
b10 is a text with value "Work with it", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "otter check .      # validate the entry point and the files it uses\notter test .       # run every test under tests/\notter run .        # run the entry point\notter build .      # build into dist/\notter publish .    # package into publish/ as a zip with a SHA-256 checksum", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b11label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b11copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b11head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11label, b11copy in b11head
b11block is a column with spacing 0, width full
put b11head, b11 in b11block
when b11copy is clicked
    copy text of b11 to clipboard
    text of b11copy is "Copied"
.
b12 is a text with value "Running 1 Otter test...\n\nPASS tests/app_test.ot\n\n1 passed", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b12label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b12copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b12head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b12label, b12copy in b12head
b12block is a column with spacing 0, width full
put b12head, b12 in b12block
when b12copy is clicked
    copy text of b12 to clipboard
    text of b12copy is "Copied"
.
b12a is a text with value "otter check . checks the entry point and every file it imports with use. Other .ot files in the project, including the tests, are not checked; otter test . runs the tests.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12b is a text with value "Web and game projects run in a browser: use otter web . for them, and otter run . for console and automation projects. Keep a web project's entry point at the project root, because relative paths to images and other assets break after otter build when the entry point is in a subfolder (to be fixed after 1.0). The one stylesheet rule is a .css file named after the entry point, beside it: main.css for main.ot. otter web, otter build and otter publish include it in the page.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b13 is a text with value "Writing a test", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b14 is a text with value "A test is an ordinary Otter file. It passes when it finishes and fails when it calls fail with:", size 16, foreground "#3a4d6b", lineheight "1.6"
b15 is a text with value "score is 100\n\nif score is not 100\n    fail with \"Expected score to be 100.\"\n.\n\nsay \"All checks passed\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b15label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b15copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b15head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b15label, b15copy in b15head
b15block is a column with spacing 0, width full
put b15head, b15 in b15block
when b15copy is clicked
    copy text of b15 to clipboard
    text of b15copy is "Copied"
.
b16 is a text with value "Build and publish", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b17 is a text with value "otter build checks the project and writes a runnable copy into dist/. otter publish builds it, packages the files into publish/<name>-<version>.zip, computes the SHA-256 checksum, and verifies the package.", size 16, foreground "#3a4d6b", lineheight "1.6"
b18 is a link with text "The otter command", url "/cli/", foreground "#2563eb", weight 600, size 15
b19 is a link with text "Modules", url "/modules/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4block, b5block, b6, b7block, b8, b9block, b9a, b9b, b10, b11block, b12block, b12a, b12b, b13, b14, b15block, b16, b17, b18, b19 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

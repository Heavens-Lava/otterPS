b1 is a text with value "Dates and Time", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "A date is a real Otter value, not text. today gives the current date; now gives the current date and time.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "date is today\nstarted is now", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b3label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b3copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b3head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b3label, b3copy in b3head
b3block is a column with spacing 0, width full
put b3head, b3 in b3block
when b3copy is clicked
    copy text of b3 to clipboard
    text of b3copy is "Copied"
.
b4 is a text with value "A date and a date-time are different", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b5 is a text with value "today has no time of day at all — it is not midnight, it simply does not carry a time. now carries both a date and a time. This is a meaningful distinction, not a technicality: a date with \"no time\" and a date at \"00:00:00\" are not the same idea, so Otter does not pretend one is the other.", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "Because of that, asking a plain date for its hour, minute, or second is invalid rather than answering with a silent zero:", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "date is today\nsay hour of date", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b7label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b7copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b7head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b7label, b7copy in b7head
b7block is a column with spacing 0, width full
put b7head, b7 in b7block
when b7copy is clicked
    copy text of b7 to clipboard
    text of b7copy is "Copied"
.
b8 is a text with value "That fails when it runs, with an error explaining that this date has no time of day. Reach for now when you need a time as well as a date.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "Reading the parts of a date", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "Date parts are read the same way any other property is read — with of, not with a period. Year, month, and day work on both a date and a date-time:", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "say year of date\nsay month of date\nsay day of date", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b11label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b11copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b11head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b11label, b11copy in b11head
b11block is a column with spacing 0, width full
put b11head, b11 in b11block
when b11copy is clicked
    copy text of b11 to clipboard
    text of b11copy is "Copied"
.
b12 is a text with value "month of date is always a number from 1 to 12, never a month name.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "Hour, minute, and second work on a date-time such as started:", size 16, foreground "#3a4d6b", lineheight "1.6"
b14 is a text with value "say hour of started\nsay minute of started\nsay second of started", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true

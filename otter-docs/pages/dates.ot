b18 is a text with value "The same words work on a date-time, down to the second:", size 16, foreground "#3a4d6b", lineheight "1.6"
b19 is a text with value "add 1 hour to started\nadd 30 minutes to started", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b19label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"

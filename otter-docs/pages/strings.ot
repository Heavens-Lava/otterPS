# Otter website - Working with text
# Authored in Otter. Scaffolded by scripts/new-docs-page.ps1, now edited here directly.

use "_shell.ot"
use "_docs.ot"

app is a page with title "Working with text - Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navDocs is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"
customstyle of sideStrings is "padding: 8px 12px; border-left: 3px solid #2563eb; border-radius: 4px; display: block; background: #e6efff; color: #1d4ed8; font-weight: 600;"
# Sidebar: only the current group is expanded.
customstyle of sideHome is "display: none;"
customstyle of sideWelcome is "display: none;"
customstyle of sideInstallation is "display: none;"
customstyle of sideFirstProgram is "display: none;"
customstyle of sideHello is "display: none;"
customstyle of sideRunningFiles is "display: none;"
customstyle of sideRepl is "display: none;"
customstyle of sideCli is "display: none;"
customstyle of sideValues is "display: none;"
customstyle of sideInputOutput is "display: none;"
customstyle of sideConditions is "display: none;"
customstyle of sideLoops is "display: none;"
customstyle of sideLists is "display: none;"
customstyle of sideFunctions is "display: none;"
customstyle of sideObjects is "display: none;"
customstyle of sideFiles is "display: none;"
customstyle of sideData is "display: none;"
customstyle of sideErrorHandling is "display: none;"
customstyle of sideMath is "display: none;"
customstyle of sideNestedConditions is "display: none;"
customstyle of sideModules is "display: none;"
customstyle of sideRunningPrograms is "display: none;"
customstyle of sideLoggingDebugging is "display: none;"
customstyle of sideEnvironment is "display: none;"
customstyle of sideDatabases is "display: none;"
customstyle of sideQueries is "display: none;"
customstyle of sideHttp is "display: none;"
customstyle of sideWebServer is "display: none;"
customstyle of sideXml is "display: none;"
customstyle of sideWebApps is "display: none;"
customstyle of sideReactivity is "display: none;"
customstyle of sideWindowsApps is "display: none;"
customstyle of sideNetworking is "display: none;"
customstyle of sideSecurity is "display: none;"
customstyle of sideExamples is "display: none;"
customstyle of sideExampleHello is "display: none;"
customstyle of sideExampleInput is "display: none;"
customstyle of sideExampleConditions is "display: none;"
customstyle of sideExampleCounting is "display: none;"
customstyle of sideExampleLists is "display: none;"
customstyle of sideExampleDiscovery is "display: none;"
customstyle of sideExampleOrganizer is "display: none;"
customstyle of sideExampleFinding is "display: none;"
customstyle of sideExampleErrors is "display: none;"
customstyle of sideDesignReadable is "display: none;"
customstyle of sideStructuralWords is "display: none;"
customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"

b1 is a text with value "Working with text", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Measure, change, search, split, and join text with plain words.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "String Length", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "say length of name", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b5 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "name is \"Jeff\"\n\nsay length of name", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b7 is a text with value "Output:", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "4", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b9 is a text with value "Uppercase and Lowercase", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "say uppercase of name\nsay lowercase of name", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b11 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "name is \"Jeff\"\n\nsay uppercase of name\nsay lowercase of name", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b13 is a text with value "Output:", size 16, foreground "#3a4d6b", lineheight "1.6"
b14 is a text with value "JEFF\njeff", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b15 is a text with value "These operations return new values.", size 16, foreground "#3a4d6b", lineheight "1.6"
b16 is a text with value "They do not automatically modify the original variable.", size 16, foreground "#3a4d6b", lineheight "1.6"
b17 is a text with value "Contains", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b18 is a text with value "Strings can be checked for text:", size 16, foreground "#3a4d6b", lineheight "1.6"
b19 is a text with value "if name contains \"Jeff\"\n    say \"Found Jeff.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b20 is a text with value "Collections can be checked for an item:", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a text with value "if games contains \"Zelda\"\n    say \"Zelda is in the list.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b22 is a text with value "The parser/runtime determines whether the target is text or a collection.", size 16, foreground "#3a4d6b", lineheight "1.6"
b23 is a text with value "Starts With", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b24 is a text with value "if name starts with \"J\"\n    say \"Starts with J.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b25 is a text with value "Ends With", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b26 is a text with value "if name ends with \"rey\"\n    say \"Ends with rey.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b27 is a text with value "Split Text", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b28 is a text with value "split \"red,green,blue\" by \",\" into colors", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b29 is a text with value "This creates a list.", size 16, foreground "#3a4d6b", lineheight "1.6"
b30 is a text with value "Equivalent example using a variable:", size 16, foreground "#3a4d6b", lineheight "1.6"
b31 is a text with value "text is \"red,green,blue\"\n\nsplit text by \",\" into colors", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b32 is a text with value "Join Text", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b33 is a text with value "join colors with \", \" into text", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b34 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b35 is a text with value "colors are\n    \"red\"\n    \"green\"\n    \"blue\"\n.\n\njoin colors with \" | \" into text\n\nsay text", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b36 is a text with value "Output:", size 16, foreground "#3a4d6b", lineheight "1.6"
b37 is a text with value "red | green | blue", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35, b36, b37 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
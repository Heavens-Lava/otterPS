b43 is a text with value "Windows paths: a single backslash before n or t becomes a new line or a tab, so \"C:\\new\\table\" is really C:, a new line, ew, a tab and able. Write \"C:\\\\new\\\\table\" with doubled backslashes, or use forward slashes, \"C:/new/table\", which Windows also accepts.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4block, b5, b6block, b7, b8block, b9, b10block, b11, b12block, b13, b14block, b15, b16, b17, b18, b19block, b20, b21block, b22, b23, b24block, b25, b26block, b27, b28block, b29, b30, b31block, b32, b33block, b34, b35block, b36, b37block, b38, b39, b40block, b41, b42block, b43 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

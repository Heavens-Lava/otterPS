b1 is a text with value "The otter command", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "One launcher runs programs, checks them, manages projects, and compiles web applications.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Commands", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "otter                          # start the interactive REPL\notter <file.ot>                # run a program (shortest form)\notter run <file.ot|project>    # run a program or project\notter check <file.ot|project>  # validate without running\notter test [target]            # run tests in a project or test file\notter build [target]           # build a project into dist/\notter publish [target]         # package a project into publish/\notter new <type> <name>        # create a project: console, desktop, web, automation, game\notter web <file.ot>            # compile to a web application and open it\notter desktop <file.ot>        # run a desktop app with the system bridge\notter studio                   # launch Otter Studio\notter help                     # show help\notter --version                # show the version", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b4label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b4copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Running programs", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "otter run hello.ot and otter hello.ot do the same thing. Anything after the file name is passed to the program in its built-in arguments list:", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "say \"Arguments received:\" length of arguments\n\neach arg in arguments\n    say \"  Arg:\" arg\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b7label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b7copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b7head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b7label, b7copy in b7head
b7block is a column with spacing 0, width full
put b7head, b7 in b7block
when b7copy is clicked
    copy text of b7 to clipboard
    text of b7copy is "Copied"
.
b8 is a text with value "Running otter run script.ot deploy staging prints Arguments received: 2, then each argument on its own line.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "Checking without running", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "otter check parses a program or a whole project and reports the first problems it finds. Nothing is executed and no files are touched, so it is safe on any file, and it suits editors and automated checks.", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "Web applications", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b12 is a text with value "otter web app.ot              # compile and open in your browser\notter web app.ot -NoOpen      # compile only; writes app.html next to the source", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b12label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b12copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b12head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b12label, b12copy in b12head
b12block is a column with spacing 0, width full
put b12head, b12 in b12block
when b12copy is clicked
    copy text of b12 to clipboard
    text of b12copy is "Copied"
.
b13 is a text with value "Options", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b14 is a text with value "-NoOpen         with otter web: write the HTML but do not open a browser\n-Port <n>       with commands that host something: the port to use\n-ParseOnly      check that a file is well formed and stop\n-DebugTokens    print the tokens the lexer produced (for people working on Otter)\n-DebugAst       print the syntax tree the parser produced\n-DebugErrors    show the underlying PowerShell error instead of the friendly one", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b14label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b14copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b14head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b14label, b14copy in b14head
b14block is a column with spacing 0, width full
put b14head, b14 in b14block
when b14copy is clicked
    copy text of b14 to clipboard
    text of b14copy is "Copied"
.
b15 is a text with value "Exit codes", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b16 is a text with value "Scripts and automated checks can rely on these to tell why otter stopped:", size 16, foreground "#3a4d6b", lineheight "1.6"
b17 is a text with value "0   success\n1   usage error: unknown command, missing argument, file not found, wrong extension\n2   the source does not parse (a syntax problem)\n3   a well-formed program failed while running", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b17label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b17copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b17head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b17label, b17copy in b17head
b17block is a column with spacing 0, width full
put b17head, b17 in b17block
when b17copy is clicked
    copy text of b17 to clipboard
    text of b17copy is "Copied"
.
b18 is a text with value "Configuration", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b19 is a text with value "Otter has no global configuration file. A project is configured by its otter.json manifest (see Projects). The one environment variable Otter reads is OTTER_BROWSER_USER_DATA_DIR, which chooses the browser profile folder used by otter desktop.", size 16, foreground "#3a4d6b", lineheight "1.6"
b20 is a text with value "If otter is not recognized, open a new terminal so it picks up the PATH, or run the launcher by its path. See Troubleshooting.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b21 is a link with text "Projects", url "/projects/", foreground "#2563eb", weight 600, size 15
b22 is a link with text "Troubleshooting", url "/troubleshooting/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4block, b5, b6, b7block, b8, b9, b10, b11, b12block, b13, b14block, b15, b16, b17block, b18, b19, b20, b21, b22 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

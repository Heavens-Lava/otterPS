b1 is a text with value "Controls", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "A control is something you see and use in a window: a button, some text, a text box, or a container that lays other controls out.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "You create a control with create, give it a name, set its properties with of, put it inside a window or container, and react to what the person does with when.", size 16, foreground "#3a4d6b", lineheight "1.6"
b4 is a text with value "create window into app\ntitle of app is \"Hello\"\n\ncreate button into helloButton\ntext of helloButton is \"Say hello\"\n\nput helloButton in app\n\nwhen helloButton is clicked\n    say \"Hello!\"\n.\n\nshow app", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b4label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b4copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Controls in Windows applications", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "These controls are available to programs that create windows (otter run app.ot). Each has its own reference page:", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a link with text "window: the application window", url "/control-window/", foreground "#2563eb", weight 600, size 15
b8 is a link with text "button, primary button, secondary button, danger button", url "/control-button/", foreground "#2563eb", weight 600, size 15
b9 is a link with text "text: a line of text", url "/control-text/", foreground "#2563eb", weight 600, size 15
b10 is a link with text "text box: text the person can edit", url "/control-text-box/", foreground "#2563eb", weight 600, size 15
b11 is a link with text "heading: a title", url "/control-heading/", foreground "#2563eb", weight 600, size 15
b12 is a link with text "card: a raised container", url "/control-card/", foreground "#2563eb", weight 600, size 15
b13 is a link with text "row: children side by side", url "/control-row/", foreground "#2563eb", weight 600, size 15
b14 is a link with text "column: children stacked", url "/control-column/", foreground "#2563eb", weight 600, size 15
b15 is a link with text "panel: a plain container", url "/control-panel/", foreground "#2563eb", weight 600, size 15
b16 is a link with text "grid: a grid container", url "/control-grid/", foreground "#2563eb", weight 600, size 15
b17 is a link with text "scroll: a scrolling container", url "/control-scroll/", foreground "#2563eb", weight 600, size 15
b18 is a text with value "Controls in web applications", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b19 is a text with value "Programs compiled with otter web are described differently - with is a and with - and have a wider set of resources (page, card, badge, link, image, checkbox, dropdown, slider, table and more). See Web applications for those.", size 16, foreground "#3a4d6b", lineheight "1.6"
b20 is a text with value "Some controls people expect, such as menus, tabs, dialogs and file pickers, are not part of the Windows control set yet. This section documents what exists today.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b21 is a link with text "Layout", url "/desktop-layout/", foreground "#2563eb", weight 600, size 15
b22 is a link with text "Events", url "/events/", foreground "#2563eb", weight 600, size 15
b23 is a link with text "Web applications", url "/web-apps/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
av1 is a text with value "Windows applications are experimental in Otter 1.0 (release scope matrix): they work and are tested, but details may change before they are fully supported. Most window programs can also be compiled into a web application with otter web, which is fully supported.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"

put b1, b2, av1, b3, b4block, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

b1 is a text with value "Support", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Where to get help, report a problem, or ask for something new.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Start with these", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a link with text "Troubleshooting: real error messages and how to fix them", url "/troubleshooting/", foreground "#2563eb", weight 600, size 15
b5 is a link with text "Verify your installation", url "/verify/", foreground "#2563eb", weight 600, size 15
b6 is a link with text "The otter command", url "/cli/", foreground "#2563eb", weight 600, size 15
b7 is a text with value "Report a bug", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "Open an issue on GitHub. The most useful reports include the smallest program that shows the problem, the exact message Otter printed, your Otter version (otter --version), and your version of Windows.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a link with text "Report a bug", url "https://github.com/Heavens-Lava/otterPS/issues", foreground "#2563eb", weight 600, size 15
b10 is a text with value "Request a feature", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "Open an issue too, and describe what you are trying to do - what you would write, and what you would expect to happen. Otter grows from real programs.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a link with text "Request a feature", url "https://github.com/Heavens-Lava/otterPS/issues", foreground "#2563eb", weight 600, size 15
b13 is a text with value "Report a documentation problem", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b14 is a text with value "A page that is wrong, unclear, or shows an example that does not work is a bug. Say which page, and what you expected.", size 16, foreground "#3a4d6b", lineheight "1.6"
b15 is a link with text "Report a documentation issue", url "https://github.com/Heavens-Lava/otterPS/issues", foreground "#2563eb", weight 600, size 15
b16 is a text with value "Frequently asked questions", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b17 is a text with value "Does Otter run on macOS or Linux? Not yet. Otter runs on Windows 10 and 11 with Windows PowerShell 5.1.", size 16, foreground "#3a4d6b", lineheight "1.6"
b18 is a text with value "Do I need PowerShell 7? No. Otter runs on the Windows PowerShell 5.1 that comes with Windows. The otter.cmd launcher finds it for you, even from PowerShell 7.", size 16, foreground "#3a4d6b", lineheight "1.6"
b19 is a text with value "Is Otter free? Yes, including for commercial use. It is not open source: see the license.", size 16, foreground "#3a4d6b", lineheight "1.6"
b20 is a text with value "Can I sell programs I write in Otter? Yes. Programs you create remain yours.", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a text with value "Where is the installer? Not published yet. Until then, run Otter from the project folder - see Installation.", size 16, foreground "#3a4d6b", lineheight "1.6"
b22 is a link with text "The license", url "/license/", foreground "#2563eb", weight 600, size 15
b23 is a link with text "Installation", url "/installation/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
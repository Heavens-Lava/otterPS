# _docs.ot - the documentation sidebar, shared by every docs page.
# Generated once by scripts/build-docs-content.ps1; edit here directly afterwards.
# A docs page marks itself as current by assigning that link's customstyle.

sideGroupHead1 is a link with text "Getting Started", url "/", foreground "#0f1f36", size 13, weight 700, customstyle "padding: 6px 12px; display: block;"
sideHome is a link with text "Overview", url "/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideWelcome is a link with text "Introduction", url "/welcome/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideInstallation is a link with text "Installation", url "/installation/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideFirstProgram is a link with text "Your first program", url "/first-program/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideHello is a link with text "Hello, Otter!", url "/hello/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideRunningFiles is a link with text "Running .ot files", url "/running-files/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideRepl is a link with text "The REPL", url "/repl/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideCli is a link with text "Command line", url "/cli/", foreground "#4a5b75", size 14, customstyle "padding: 8px 12px; border-left: 3px solid transparent; border-radius: 4px; display: block;"
sideGroup1 is a column with spacing 2
put sideGroupHead1, sideHome, sideWelcome, sideInstallation, sideFirstProgram, sideHello, sideRunningFiles, sideRepl, sideCli in sideGroup1


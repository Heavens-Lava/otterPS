b1 is a text with value "try and otherwise", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "try runs a block; if something in it fails, otherwise handles it.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Try and Otherwise", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "Otter uses:", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "try\n    ...\notherwise\n    ...\n.", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b5label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b5copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b5head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b5label, b5copy in b5head
b5block is a column with spacing 0, width full
put b5head, b5 in b5block
when b5copy is clicked
    copy text of b5 to clipboard
    text of b5copy is "Copied"
.
b6 is a text with value "for error handling.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "try\n    read \"settings.json\" into settings\notherwise\n    say \"Could not load settings.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b8label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b8copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b8head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b8label, b8copy in b8head
b8block is a column with spacing 0, width full
put b8head, b8 in b8block
when b8copy is clicked
    copy text of b8 to clipboard
    text of b8copy is "Copied"
.
b9 is a text with value "If the try body completes normally, the otherwise body does not run.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "If an operation in the try body fails, Otter runs the otherwise body.", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "Otherwise Is Optional for Try", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b12 is a text with value "A try block may exist without an otherwise body when the runtime or surrounding code handles the failure.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "try\n    read \"settings.json\" into settings\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b13label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b13copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b13head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b13label, b13copy in b13head
b13block is a column with spacing 0, width full
put b13head, b13 in b13block
when b13copy is clicked
    copy text of b13 to clipboard
    text of b13copy is "Copied"
.
b14 is a text with value "The exact propagation behavior should follow Otter's runtime error rules.", size 16, foreground "#3a4d6b", lineheight "1.6"
b15 is a text with value "Normal Control Flow Is Not Failure", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b16 is a text with value "Statements such as:", size 16, foreground "#3a4d6b", lineheight "1.6"
b17 is a text with value "return", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b17label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b17copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b17head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b17label, b17copy in b17head
b17block is a column with spacing 0, width full
put b17head, b17 in b17block
when b17copy is clicked
    copy text of b17 to clipboard
    text of b17copy is "Copied"
.
b18 is a text with value "must pass through try normally.", size 16, foreground "#3a4d6b", lineheight "1.6"
b19 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b20 is a text with value "to findUser user\n    try\n        return user\n    otherwise\n        say \"Could not find user.\"\n    .\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b20label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b20copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b20head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b20label, b20copy in b20head
b20block is a column with spacing 0, width full
put b20head, b20 in b20block
when b20copy is clicked
    copy text of b20 to clipboard
    text of b20copy is "Copied"
.
b21 is a text with value "If return user executes successfully, the function returns user.", size 16, foreground "#3a4d6b", lineheight "1.6"
b22 is a text with value "The otherwise body must not run.", size 16, foreground "#3a4d6b", lineheight "1.6"
b23 is a text with value "Normal control-flow changes are not runtime errors.", size 16, foreground "#3a4d6b", lineheight "1.6"
b24 is a text with value "This rule should also apply to future control-flow features such as:", size 16, foreground "#3a4d6b", lineheight "1.6"
b25 is a text with value "break\ncontinue", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b25label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b25copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b25head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b25label, b25copy in b25head
b25block is a column with spacing 0, width full
put b25head, b25 in b25block
when b25copy is clicked
    copy text of b25 to clipboard
    text of b25copy is "Copied"
.

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5block, b6, b7, b8block, b9, b10, b11, b12, b13block, b14, b15, b16, b17block, b18, b19, b20block, b21, b22, b23, b24, b25block in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

# Otter website - Examples
# Authored in Otter. Scaffolded by scripts/new-docs-page.ps1, now edited here directly.

use "_shell.ot"
use "_docs.ot"

app is a page with title "Examples - Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navExamples is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"
customstyle of sideExamples is "padding: 8px 12px; border-left: 3px solid #2563eb; border-radius: 4px; display: block; background: #e6efff; color: #1d4ed8; font-weight: 600;"
# Sidebar: only the current group is expanded.
customstyle of sideHome is "display: none;"
customstyle of sideWelcome is "display: none;"
customstyle of sideInstallation is "display: none;"
customstyle of sideFirstProgram is "display: none;"
customstyle of sideHello is "display: none;"

customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"

b1 is a text with value "Otter examples", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Learn by changing real programs. Each example is a real .ot file from the Otter project - open one, change it, and run it.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Hello, Otter!", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "The smallest useful Otter program.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "say \"Hello, Otter!\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;", runnable true
b6 is a link with text "View hello.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/hello.ot", foreground "#2563eb", weight 600, size 15
b7 is a link with text "Read the tutorial", url "/first-program/", foreground "#2563eb", weight 600, size 15
b8 is a text with value "Calculator", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b9 is a text with value "A native UI app with text boxes, a button, and error handling.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a link with text "View calculator.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/calculator.ot", foreground "#2563eb", weight 600, size 15
b11 is a text with value "Files and folders", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b12 is a text with value "Discover and inspect files with straightforward Otter statements.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a link with text "View files.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/files.ot", foreground "#2563eb", weight 600, size 15
b14 is a link with text "Read file documentation", url "/files/", foreground "#2563eb", weight 600, size 15
b15 is a text with value "CSV", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b16 is a text with value "Parse tabular data into objects and write it back out.", size 16, foreground "#3a4d6b", lineheight "1.6"
b17 is a link with text "View csv.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/csv.ot", foreground "#2563eb", weight 600, size 15
b18 is a link with text "Read CSV documentation", url "/data/", foreground "#2563eb", weight 600, size 15
b19 is a text with value "Database tasks", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b20 is a text with value "Work with a real database from Otter.", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a link with text "View database-tasks.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/database-tasks.ot", foreground "#2563eb", weight 600, size 15
b22 is a text with value "API server", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b23 is a text with value "Answer web requests with Otter routes.", size 16, foreground "#3a4d6b", lineheight "1.6"
b24 is a link with text "View api-server.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/api-server.ot", foreground "#2563eb", weight 600, size 15
b25 is a text with value "Web showcase", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b26 is a text with value "An interactive web application compiled with otter web.", size 16, foreground "#3a4d6b", lineheight "1.6"
b27 is a link with text "View showcase.ot source", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/showcase.ot", foreground "#2563eb", weight 600, size 15
b28 is a text with value "Step-by-step walkthroughs", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b29 is a link with text "Hello World", url "/example-hello/", foreground "#2563eb", weight 600, size 15
b30 is a link with text "User input", url "/example-input/", foreground "#2563eb", weight 600, size 15
b31 is a link with text "Conditions", url "/example-conditions/", foreground "#2563eb", weight 600, size 15
b32 is a link with text "Counting", url "/example-counting/", foreground "#2563eb", weight 600, size 15
b33 is a link with text "Lists", url "/example-lists/", foreground "#2563eb", weight 600, size 15
b34 is a link with text "File discovery", url "/example-discovery/", foreground "#2563eb", weight 600, size 15
b35 is a link with text "File organizer", url "/example-organizer/", foreground "#2563eb", weight 600, size 15
b36 is a link with text "Finding files", url "/example-finding/", foreground "#2563eb", weight 600, size 15
b37 is a link with text "Handling errors", url "/example-errors/", foreground "#2563eb", weight 600, size 15
b38 is a text with value "Otter Studio", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b39 is a text with value "Development preview only. Studio is not yet a certified Otter V1 command.", size 16, foreground "#3a4d6b", lineheight "1.6"
b40 is a link with text "Read about Studio status", url "/studio/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35, b36, b37, b38, b39, b40 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

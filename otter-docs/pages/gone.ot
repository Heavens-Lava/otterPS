b1 is a text with value "gone: the absence of a value", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "gone means no value exists. It is not the same as empty text, zero, an empty list, or false.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "Gone — Absence of a Value", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "Otter uses:", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "gone", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b6 is a text with value "to represent the absence of a value.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "gone is Otter's equivalent of concepts such as null, nil, or None in other programming languages.", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "Example:", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "user is gone", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b10 is a text with value "Check for an absent value:", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "if user is gone\n    say \"User was not found.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b12 is a text with value "Check that a value exists:", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "if user is not gone\n    say \"Welcome\" name of user\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b14 is a text with value "gone is a literal value.", size 16, foreground "#3a4d6b", lineheight "1.6"
b15 is a text with value "It does not require special assignment syntax.", size 16, foreground "#3a4d6b", lineheight "1.6"
b16 is a text with value "user is gone", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b17 is a text with value "uses the same assignment rules as:", size 16, foreground "#3a4d6b", lineheight "1.6"
b18 is a text with value "user is \"Jeff\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b19 is a text with value "Gone Is Different From Empty and False", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b20 is a text with value "These values are not equivalent:", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a text with value "user is gone\nname is \"\"\nscore is 0\ngames are empty\nready is false", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto;"
b22 is a text with value "They mean:", size 16, foreground "#3a4d6b", lineheight "1.6"
b23 is a text with value "gone       no value exists\n\"\"         a string exists but contains no characters\n0          a number exists and is zero\nempty      a collection exists but contains no items\nfalse      a boolean exists and is false", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b24 is a text with value "Otter must not automatically treat these values as interchangeable.", size 16, foreground "#3a4d6b", lineheight "1.6"
b25 is a text with value "Gone Is the Only Absence Keyword", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b26 is a text with value "Otter uses only:", size 16, foreground "#3a4d6b", lineheight "1.6"
b27 is a text with value "gone", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b28 is a text with value "for absence.", size 16, foreground "#3a4d6b", lineheight "1.6"
b29 is a text with value "Do not introduce aliases such as:", size 16, foreground "#3a4d6b", lineheight "1.6"
b30 is a text with value "null\nnil\nNone\nnothing\nNA", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto;"
b31 is a text with value "This keeps the language consistent and prevents multiple words from representing the same concept.", size 16, foreground "#3a4d6b", lineheight "1.6"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28, b29, b30, b31 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
b1 is a text with value "The Otter Free Use License", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter is free to download, install and use - personally, in school, at work, and to build commercial software. This page summarizes the license; the full text is the authority.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "This is a plain-language summary, not legal advice. The complete license is in the LICENSE file of the project.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"
b4 is a text with value "What you can do", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b5 is a text with value "- Download, install and use Otter free of charge for personal, educational, academic, nonprofit and commercial purposes. No fee or royalty is due.", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "- Own what you make. Programs, apps, scripts, websites and games you create with Otter remain yours. You can copy, modify, distribute, license and sell them.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "- Say that your software was created with, written in, or is compatible with Otter.", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "What you cannot do", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b9 is a text with value "- Redistribute, republish, sublicense, sell, rent or repackage Otter itself without written permission.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "- Modify, reverse engineer, decompile or create derivative works of Otter itself without written permission (except where the law says you may).", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "- Use the Otter name, logos or branding to suggest that an unofficial product, modified version or service is an official Otter product.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "Ownership", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b13 is a text with value "Otter itself is proprietary software: providing it free of charge does not transfer ownership. The license does not grant a right to Otter's private source code.", size 16, foreground "#3a4d6b", lineheight "1.6"
b14 is a link with text "Read the full license on GitHub", url "https://github.com/Heavens-Lava/otterPS/blob/master/LICENSE", foreground "#2563eb", weight 600, size 15
b15 is a link with text "Third-party notices", url "https://github.com/Heavens-Lava/otterPS/blob/master/THIRD-PARTY-NOTICES.md", foreground "#2563eb", weight 600, size 15
b16 is a link with text "About Otter", url "/about/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app
customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"
customstyle of sideSupport is "display: none;"
customstyle of sideAbout is "display: none;"
customstyle of sideLicense is "display: none;"

b1 is a text with value "What is Otter?", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Otter is a programming language you can read aloud. Programs use everyday words and indentation instead of punctuation-heavy syntax, and they still behave exactly and predictably.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "name is \"Otter\"\nsay \"Hello, \" + name\n\nto greet person\n    say \"Welcome, \" + person\n.\n\ngreet \"Ada\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b3label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b3copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b3head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b3label, b3copy in b3head
b3block is a column with spacing 0, width full
put b3head, b3 in b3block
when b3copy is clicked
    copy text of b3 to clipboard
    text of b3copy is "Copied"
.
b4 is a text with value "Hello, Otter\nWelcome, Ada", size 14, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;"
b4label is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
b4copy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
b4head is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b4label, b4copy in b4head
b4block is a column with spacing 0, width full
put b4head, b4 in b4block
when b4copy is clicked
    copy text of b4 to clipboard
    text of b4copy is "Copied"
.
b5 is a text with value "Readable like English. Precise like code.", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b6 is a text with value "Every statement has one clear meaning. Words such as is, and, minus, is at least and of do the work that symbols do in other languages, so a program reads like a description of what it does. Blocks are closed with a period, and a period is never used for anything else.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "What runs Otter", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b8 is a text with value "Otter runs on Windows PowerShell 5.1, which is already part of Windows 10 and Windows 11. There is nothing extra to install. The otter command runs programs, checks them, starts an interactive session, creates and builds projects, and compiles programs into web applications.", size 16, foreground "#3a4d6b", lineheight "1.6"
b9 is a text with value "What makes it different", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b10 is a text with value "- Statements read as sentences: age is 29, say \"Hello\", add 5 to score.", size 16, foreground "#3a4d6b", lineheight "1.6"
b11 is a text with value "- Errors are written for people: the message names the line, says what went wrong in plain words, and suggests a fix. Raw stack traces never reach you.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "- One small set of ideas covers scripts, desktop apps, web apps, servers, files, data and networking.", size 16, foreground "#3a4d6b", lineheight "1.6"
b13 is a text with value "- No hidden magic: a missing variable is an error, dividing by zero is an error, and text is never silently converted to bytes.", size 16, foreground "#3a4d6b", lineheight "1.6"
b14 is a link with text "Who is Otter for?", url "/who-is-otter-for/", foreground "#2563eb", weight 600, size 15
b15 is a link with text "What can you build?", url "/what-can-you-build/", foreground "#2563eb", weight 600, size 15
b16 is a link with text "Install Otter", url "/installation/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3block, b4block, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

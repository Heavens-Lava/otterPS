b1 is a text with value "Property Access", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Properties are written property-first: name of person. A period is not property access.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "person has\n    name is \"Ada\"\n.\nsay name of person", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b3label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b3copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b3head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b3label, b3copy in b3head
b3block is a column with spacing 0, width full
put b3head, b3 in b3block
when b3copy is clicked
    copy text of b3 to clipboard
    text of b3copy is "Copied"
.
b4 is a text with value "Property access nests, reading right to left. This is the city of the address of the user:", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "address has\n    city is \"London\"\n.\nuser has\n    address is address\n.\nsay city of address of user", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b5label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b5copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b5head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b5label, b5copy in b5head
b5block is a column with spacing 0, width full
put b5head, b5 in b5block
when b5copy is clicked
    copy text of b5 to clipboard
    text of b5copy is "Copied"
.
b6 is a text with value "A property can also be assigned:", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "person has\n    age is 29\n.\nage of person is 30\nsay age of person", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
b7label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b7copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b7head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b7label, b7copy in b7head
b7block is a column with spacing 0, width full
put b7head, b7 in b7block
when b7copy is clicked
    copy text of b7 to clipboard
    text of b7copy is "Copied"
.
b8 is a text with value "Write name of person, never person.name. Otter reserves the period for closing a block.", size 15, foreground "#1e3a6b", background "#eaf2ff", radius 12, border "1px solid #cfe0ff", lineheight "1.55", customstyle "padding: 14px 18px;"

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3block, b4, b5block, b6, b7block, b8 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

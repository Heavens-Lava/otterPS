# Otter website - Build a Task Manager
# The complete example is examples/v1/tasks.ot.

use "_shell.ot"
use "_docs.ot"

app is a page with title "Build a Task Manager - Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0


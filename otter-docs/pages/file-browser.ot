b1 is a text with value "Build a File Browser", size 40, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1.1"
b2 is a text with value "Build a small Windows application that lists the files in any folder you type. About 50 lines, and it uses windows, rows, text boxes, buttons, scrolling, a click event, error handling and file listing.", size 18, foreground "#3a4d6b", lineheight "1.55"
b3 is a text with value "What you will learn", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b4 is a text with value "- Laying out a window with a row and a column.", size 16, foreground "#3a4d6b", lineheight "1.6"
b5 is a text with value "- Setting several properties at once with has.", size 16, foreground "#3a4d6b", lineheight "1.6"
b6 is a text with value "- Reading a text box, listing a folder with get files in, and adding controls while the program runs.", size 16, foreground "#3a4d6b", lineheight "1.6"
b7 is a text with value "- Recovering from a bad folder name with try and otherwise.", size 16, foreground "#3a4d6b", lineheight "1.6"
b8 is a text with value "Before you start", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b9 is a text with value "You need Otter on Windows and a folder where you can save a .ot file. This is a Windows application, so run it with otter run.", size 16, foreground "#3a4d6b", lineheight "1.6"
b10 is a text with value "1. The window and its heading", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b11 is a text with value "A window holds the whole application. has sets several properties in one line.", size 16, foreground "#3a4d6b", lineheight "1.6"
b12 is a text with value "create window into app\napp has title \"Otter File Utility\", width 800, height 550, background \"#111827\", spacing 12\n\ncreate text into heading\nheading has text \"Folder Browser\", foreground \"white\"", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b12label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b12copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b12head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b12label, b12copy in b12head
b12block is a column with spacing 0, width full
put b12head, b12 in b12block
when b12copy is clicked
    copy text of b12 to clipboard
    text of b12copy is "Copied"
.
b13 is a text with value "2. A text box and a button, side by side", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b14 is a text with value "The person types a folder path and presses Load Files. A row places the two next to each other; spacing sets the gap.", size 16, foreground "#3a4d6b", lineheight "1.6"
b15 is a text with value "create text box into folderBox\nfolderBox has width 500\n\ncreate button into loadButton\nloadButton has text \"Load Files\", width 120, background \"#2563EB\", foreground \"white\"\n\ncreate row into toolbar\ntoolbar has spacing 10\n\nput folderBox, loadButton in toolbar", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b15label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b15copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b15head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b15label, b15copy in b15head
b15block is a column with spacing 0, width full
put b15head, b15 in b15block
when b15copy is clicked
    copy text of b15 to clipboard
    text of b15copy is "Copied"
.
b16 is a text with value "3. A status line and a scrolling list", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b17 is a text with value "The results go in a column, and the column goes inside a scroll so the list stays reachable however many files there are.", size 16, foreground "#3a4d6b", lineheight "1.6"
b18 is a text with value "create text into statusText\nstatusText has text \"Enter a folder path.\", foreground \"white\"\n\ncreate column into resultsColumn\nresultsColumn has spacing 4\n\ncreate scroll into fileArea\nfileArea has width 760, height 350\n\nput resultsColumn in fileArea\nput heading, toolbar, statusText, fileArea in app", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b18label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b18copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b18head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b18label, b18copy in b18head
b18block is a column with spacing 0, width full
put b18head, b18 in b18block
when b18copy is clicked
    copy text of b18 to clipboard
    text of b18copy is "Copied"
.
b19 is a text with value "4. Load the files when the button is clicked", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b20 is a text with value "Inside the event, get files in reads the folder. try ... otherwise keeps a mistyped path from stopping the program. Each file gets its own text control, added to the column.", size 16, foreground "#3a4d6b", lineheight "1.6"
b21 is a text with value "when loadButton is clicked\n    try\n        folder is text of folderBox\n        get files in folder into files\n        total is length of files\n        text of statusText is total\n        for each file in files\n            create text into fileLabel\n            fileLabel has text name of file, foreground \"#94a3b8\"\n            put fileLabel in resultsColumn\n        .\n    otherwise\n        text of statusText is \"Could not load that folder.\"\n.", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b21label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b21copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b21head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b21label, b21copy in b21head
b21block is a column with spacing 0, width full
put b21head, b21 in b21block
when b21copy is clicked
    copy text of b21 to clipboard
    text of b21copy is "Copied"
.
b22 is a text with value "5. Show the window", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b23 is a text with value "show app", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b23label is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
b23copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b23head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b23label, b23copy in b23head
b23block is a column with spacing 0, width full
put b23head, b23 in b23block
when b23copy is clicked
    copy text of b23 to clipboard
    text of b23copy is "Copied"
.
b24 is a text with value "Run it", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b25 is a text with value "otter run file-browser.ot", size 14, foreground "#e5edf8", background "#0f1b2e", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 18px 22px; line-height: 1.7; overflow-x: auto; border-top-left-radius: 0; border-top-right-radius: 0;", runnable false
b25label is a text with value "PowerShell", size 12, weight 600, foreground "#b7c4d8"
b25copy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
b25head is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put b25label, b25copy in b25head
b25block is a column with spacing 0, width full
put b25head, b25 in b25block
when b25copy is clicked
    copy text of b25 to clipboard
    text of b25copy is "Copied"
.
b26 is a text with value "Expected result", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b27 is a text with value "A dark 800 by 550 window titled Otter File Utility with a Folder Browser heading, a text box and a Load Files button. Type a folder such as C:\\Users\\you\\Documents and press Load Files: the status line shows how many files there are, and their names fill the scrolling list. A path that does not exist shows \"Could not load that folder.\"", size 16, foreground "#3a4d6b", lineheight "1.6"
b28 is a text with value "Common problems", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b29 is a text with value "- Nothing happens: check the path. A relative path is relative to the folder you ran otter from.", size 16, foreground "#3a4d6b", lineheight "1.6"
b30 is a text with value "- The window does not open: this is a Windows application. Run it with otter run, not otter web.", size 16, foreground "#3a4d6b", lineheight "1.6"
b31 is a text with value "- Otter says a name is not defined: create every control before you use it, and create it with the exact name you use later.", size 16, foreground "#3a4d6b", lineheight "1.6"
b32 is a text with value "Challenges", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b33 is a text with value "- Show only files that end with .txt: test extension of file inside the loop.", size 16, foreground "#3a4d6b", lineheight "1.6"
b34 is a text with value "- Show the file sizes beside the names (size of file).", size 16, foreground "#3a4d6b", lineheight "1.6"
b35 is a text with value "- Clear the list before loading a new folder.", size 16, foreground "#3a4d6b", lineheight "1.6"
b36 is a text with value "The complete program", size 26, weight 800, foreground "#0b1d36", letterspacing "-0.02em", margin "14px 0 0 0"
b37 is a link with text "View the complete file-browser.ot on GitHub", url "https://github.com/Heavens-Lava/otterPS/blob/master/examples/v1/file-browser.ot", foreground "#2563eb", weight 600, size 15
b38 is a link with text "Controls", url "/controls/", foreground "#2563eb", weight 600, size 15
b39 is a link with text "Events", url "/events/", foreground "#2563eb", weight 600, size 15
b40 is a link with text "Files and folders", url "/files/", foreground "#2563eb", weight 600, size 15

docsMain is a column with spacing 16, flex 1, padding "40px 56px 24px", customstyle "box-sizing: border-box; min-width: 0; max-width: 940px;"
put b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12block, b13, b14, b15block, b16, b17, b18block, b19, b20, b21block, b22, b23block, b24, b25block, b26, b27, b28, b29, b30, b31, b32, b33, b34, b35, b36, b37, b38, b39, b40 in docsMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, docsMain in docsBody

put topBar, docsBody, siteFooter in app
show app

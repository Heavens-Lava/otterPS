# Otter website - Documentation overview
# Authored in Otter and compiled with the site build (build-otter-pages.ps1).

use "_shell.ot"
use "_docs.ot"

app is a page with title "Otter Documentation", hideheader true, scroll true, width full, background "#f4f7fb", foreground "#0f1f36", spacing 0, padding 0

customstyle of navDocs is "padding: 22px 0; border-bottom: 2px solid #4d8dff; color: #ffffff;"
customstyle of sideDocs is "padding: 8px 12px; border-left: 3px solid #2563eb; border-radius: 4px; display: block; background: #e6efff; color: #1d4ed8; font-weight: 600;"
# Sidebar: only the current group is expanded.
customstyle of sideCli is "display: none;"
customstyle of sideProjects is "display: none;"
customstyle of sideTroubleshooting is "display: none;"
customstyle of sideValues is "display: none;"
customstyle of sideInputOutput is "display: none;"
customstyle of sideConditions is "display: none;"
customstyle of sideLoops is "display: none;"
customstyle of sideLists is "display: none;"
customstyle of sideFunctions is "display: none;"
customstyle of sideObjects is "display: none;"
customstyle of sideFiles is "display: none;"
customstyle of sideData is "display: none;"
customstyle of sideErrorHandling is "display: none;"
customstyle of sideMath is "display: none;"
customstyle of sideNestedConditions is "display: none;"
customstyle of sideModules is "display: none;"
customstyle of sideRunningPrograms is "display: none;"
customstyle of sideLoggingDebugging is "display: none;"
customstyle of sideEnvironment is "display: none;"
customstyle of sideGone is "display: none;"
customstyle of sideOperators is "display: none;"
customstyle of sidePropertyAccess is "display: none;"
customstyle of sideStrings is "display: none;"
customstyle of sideCollections is "display: none;"
customstyle of sideDiscovery is "display: none;"
customstyle of sideFileObjects is "display: none;"
customstyle of sideFilesFolders is "display: none;"
customstyle of sideFolders is "display: none;"
customstyle of sideTry is "display: none;"
customstyle of sideJson is "display: none;"
customstyle of sideRandom is "display: none;"
customstyle of sideDates is "display: none;"
customstyle of sideScope is "display: none;"
customstyle of sideDiagnostics is "display: none;"
customstyle of sideReference is "display: none;"
customstyle of sideDatabases is "display: none;"
customstyle of sideQueries is "display: none;"
customstyle of sideHttp is "display: none;"
customstyle of sideWebServer is "display: none;"
customstyle of sideXml is "display: none;"
customstyle of sideWebApps is "display: none;"
customstyle of sideReactivity is "display: none;"
customstyle of sideWindowsApps is "display: none;"
customstyle of sideNetworking is "display: none;"
customstyle of sideSecurity is "display: none;"
customstyle of sideExamples is "display: none;"
customstyle of sideExampleHello is "display: none;"
customstyle of sideExampleInput is "display: none;"
customstyle of sideExampleConditions is "display: none;"
customstyle of sideExampleCounting is "display: none;"
customstyle of sideExampleLists is "display: none;"
customstyle of sideExampleDiscovery is "display: none;"
customstyle of sideExampleOrganizer is "display: none;"
customstyle of sideExampleFinding is "display: none;"
customstyle of sideExampleErrors is "display: none;"
customstyle of sideDesignReadable is "display: none;"
customstyle of sideStructuralWords is "display: none;"
customstyle of sidePropertiesOperations is "display: none;"
customstyle of sidePeriods is "display: none;"
customstyle of sidePhilosophy is "display: none;"
customstyle of sideTopics is "display: none;"
customstyle of sideDownload is "display: none;"
customstyle of sideRelease is "display: none;"
customstyle of sideStudio is "display: none;"
customstyle of sideSupport is "display: none;"
customstyle of sideAbout is "display: none;"
customstyle of sideLicense is "display: none;"

# ==========================================
# 1. HERO
# ==========================================

heroTitle is a text with value "Documentation", size 46, weight 800, foreground "#0b1d36", letterspacing "-0.03em", lineheight "1"
heroLead is a text with value "Readable like English. Precise like code. Learn Otter from the ground up, on a runtime that needs nothing installed.", size 19, foreground "#3a4d6b", lineheight "1.5", customstyle "max-width: 520px;"
heroCopy is a column with spacing 16, flex 1
put heroTitle, heroLead in heroCopy
heroMascot is a image with source "/static/images/otter-docs-hero-mascot.png", alt "The Otter mascot sitting on a rock", height 230
hero is a row with spread, align middle, spacing 32, width full, background "#e4edf9", padding "24px 48px", customstyle "box-sizing: border-box; background-image: linear-gradient(90deg, rgba(244,249,255,.94) 0%, rgba(244,249,255,.80) 48%, rgba(244,249,255,.12) 100%), url('/static/images/otter-docs-mountain-backdrop.png'); background-size: cover; background-position: center; overflow: hidden;"
put heroCopy, heroMascot in hero

# ==========================================
# 2. ENTRY CARDS
# ==========================================

cardOneTitle is a link with text "Get Started", url "/installation/", foreground "#0f1f36", size 17, weight 700
cardOneBody is a text with value "Install Otter and run your first program.", size 14, foreground "#4a5b75", lineheight "1.45"
cardOne is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 22, spacing 10, flex 1
put cardOneTitle, cardOneBody in cardOne

cardTwoTitle is a link with text "Language Guide", url "/values/", foreground "#0f1f36", size 17, weight 700
cardTwoBody is a text with value "Learn the core ideas, one at a time.", size 14, foreground "#4a5b75", lineheight "1.45"
cardTwo is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 22, spacing 10, flex 1
put cardTwoTitle, cardTwoBody in cardTwo

cardThreeTitle is a link with text "Reference", url "/reference/", foreground "#0f1f36", size 17, weight 700
cardThreeBody is a text with value "What Otter V1 supports, in one index.", size 14, foreground "#4a5b75", lineheight "1.45"
cardThree is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 22, spacing 10, flex 1
put cardThreeTitle, cardThreeBody in cardThree

cardFourTitle is a link with text "Examples", url "/examples/", foreground "#0f1f36", size 17, weight 700
cardFourBody is a text with value "Real programs to open, change, and run.", size 14, foreground "#4a5b75", lineheight "1.45"
cardFour is a card with background "#ffffff", radius 16, border "1px solid #e3e9f2", padding 22, spacing 10, flex 1
put cardFourTitle, cardFourBody in cardFour

entryCards is a row with spacing 20, align top, width full
put cardOne, cardTwo, cardThree, cardFour in entryCards

# ==========================================
# 3. YOUR FIRST PROGRAM
# ==========================================

firstTitle is a text with value "Your first program", size 30, weight 800, foreground "#0b1d36", letterspacing "-0.02em"
firstBody is a text with value "Create a file called hello.ot and add one line:", size 16, foreground "#3a4d6b"
firstCode is a text with value "# Your first Otter program\nsay \"Hello, Otter!\"", size 15, foreground "#e5edf8", background "#0f1b2e", radius 14, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 20px 22px; line-height: 1.7; border-top-left-radius: 0; border-top-right-radius: 0;", runnable true
firstCodelabel is a text with value "Otter", size 12, weight 600, foreground "#b7c4d8"
firstCodecopy is a button with text "Copy", size 12, weight 600, background "#22375a", foreground "#e5edf8", radius 6, padding "4px 12px"
firstCodehead is a row with spread, align middle, width full, background "#16263f", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put firstCodelabel, firstCodecopy in firstCodehead
firstCodeblock is a column with spacing 0, width full
put firstCodehead, firstCode in firstCodeblock
when firstCodecopy is clicked
    copy text of firstCode to clipboard
    text of firstCodecopy is "Copied"
.
firstRunBody is a text with value "Run it from PowerShell:", size 16, foreground "#3a4d6b"
firstRun is a text with value "otter run hello.ot", size 15, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; border-top-left-radius: 0; border-top-right-radius: 0;"
firstRunlabel is a text with value "Terminal", size 12, weight 600, foreground "#4a5b75"
firstRuncopy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
firstRunhead is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put firstRunlabel, firstRuncopy in firstRunhead
firstRunblock is a column with spacing 0, width full
put firstRunhead, firstRun in firstRunblock
when firstRuncopy is clicked
    copy text of firstRun to clipboard
    text of firstRuncopy is "Copied"
.
firstOutBody is a text with value "You should see:", size 16, foreground "#3a4d6b"
firstOut is a text with value "Hello, Otter!", size 15, foreground "#0f1f36", background "#e8eef7", radius 12, fontfamily "'JetBrains Mono', Consolas, monospace", whitespace "pre", customstyle "padding: 16px 22px; border-top-left-radius: 0; border-top-right-radius: 0;"
firstOutlabel is a text with value "Output", size 12, weight 600, foreground "#4a5b75"
firstOutcopy is a button with text "Copy", size 12, weight 600, background "#c9d6e8", foreground "#0f1f36", radius 6, padding "4px 12px"
firstOuthead is a row with spread, align middle, width full, background "#dde6f2", padding "8px 14px", customstyle "box-sizing: border-box; border-radius: 12px 12px 0 0;"
put firstOutlabel, firstOutcopy in firstOuthead
firstOutblock is a column with spacing 0, width full
put firstOuthead, firstOut in firstOutblock
when firstOutcopy is clicked
    copy text of firstOut to clipboard
    text of firstOutcopy is "Copied"
.
firstMore is a link with text "Follow the full walkthrough", url "/first-program/", foreground "#2563eb", size 15, weight 600
firstSection is a column with spacing 14
put firstTitle, firstBody, firstCodeblock, firstRunBody, firstRunblock, firstOutBody, firstOutblock, firstMore in firstSection

# ==========================================
# 4. WHAT'S NEXT
# ==========================================

nextTitle is a text with value "What's next?", size 30, weight 800, foreground "#0b1d36", letterspacing "-0.02em"
nextBody is a text with value "Explore the rest of the documentation to learn more about the language and its features.", size 16, foreground "#3a4d6b"
nextOneTitle is a link with text "Language concepts", url "/values/", foreground "#0f1f36", size 16, weight 700
nextOneBody is a text with value "Values, conditions, loops, lists, functions, and objects.", size 14, foreground "#4a5b75", lineheight "1.45"
nextOne is a card with background "#ffffff", radius 14, border "1px solid #e3e9f2", padding 20, spacing 6, flex 1
put nextOneTitle, nextOneBody in nextOne
nextTwoTitle is a link with text "Files, data and the network", url "/files/", foreground "#0f1f36", size 16, weight 700
nextTwoBody is a text with value "Files and folders, CSV, downloads, TCP, UDP, and TLS.", size 14, foreground "#4a5b75", lineheight "1.45"
nextTwo is a card with background "#ffffff", radius 14, border "1px solid #e3e9f2", padding 20, spacing 6, flex 1
put nextTwoTitle, nextTwoBody in nextTwo
nextThreeTitle is a link with text "Build something", url "/examples/", foreground "#0f1f36", size 16, weight 700
nextThreeBody is a text with value "Open a complete example and change it to make it yours.", size 14, foreground "#4a5b75", lineheight "1.45"
nextThree is a card with background "#ffffff", radius 14, border "1px solid #e3e9f2", padding 20, spacing 6, flex 1
put nextThreeTitle, nextThreeBody in nextThree
nextCards is a row with spacing 20, align top, width full
put nextOne, nextTwo, nextThree in nextCards
nextSection is a column with spacing 14
put nextTitle, nextBody, nextCards in nextSection

# ==========================================
# 5. PAGE
# ==========================================

homeBody is a column with spacing 32, width full, padding "28px 48px 24px", flex 1, customstyle "box-sizing: border-box; min-width: 0;"
put entryCards, firstSection, nextSection in homeBody
homeMain is a column with spacing 0, flex 1, customstyle "min-width: 0;"
put hero, homeBody in homeMain
docsBody is a row with align top, spacing 0, width full, customstyle "align-items: stretch;"
put docsSidebar, homeMain in docsBody

put topBar, docsBody, siteFooter in app
show app
